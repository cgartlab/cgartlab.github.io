# ===================================================
# cgartlab.github.io — 换行符策略
# 所有文本文件统一 LF（在各设备上检出都是 LF）
# 彻底避免 CRLF/LF 跨设备冲突
# ===================================================

# 默认规则：自动检测文本文件，全部转换为 LF
* text=auto eol=lf

# ---------- 明确声明二进制文件 ----------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.eot      binary
*.ttf      binary
*.otf      binary
*.pdf      binary
*.zip      binary
*.tar.gz   binary
*.mp4      binary
*.mp3      binary
*.wav      binary
*.mov      binary
*.avi      binary
