{
  "name": "cgartlab-com",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.10.0",
  "repository": "https://github.com/cgartlab/cgartlab.github.io",
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "astro check && pnpm fetch-github-repos && astro build && tsx scripts/generate-llms.ts && pnpm apply-lqip",
    "preview": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "new-post": "tsx scripts/new-post.ts",
    "apply-lqip": "tsx scripts/apply-lqip.ts",
    "format-posts": "tsx scripts/format-posts.ts",
    "fix-internal-links": "tsx scripts/fix-internal-links.ts",
    "verify-feed": "tsx scripts/verify-feed.ts",
    "audit-glossary": "tsx scripts/audit-glossary.ts",
    "sync-docs": "tsx scripts/sync-doc-facts.ts --write",
    "sync-docs:check": "tsx scripts/sync-doc-facts.ts --check",
    "update-gh-contributions": "tsx scripts/update-gh-contributions.ts",
    "fetch-github-repos": "tsx scripts/fetch-github-repos.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.3",
    "@waline/client": "^3.15.2",
    "astro": "^7.2.4",
    "astro-compress": "^2.4.3",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "feed": "^5.2.1",
    "katex": "^0.16.47",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it": "^14.2.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.0",
    "node-html-parser": "^7.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^2.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "twikoo": "^1.7.19",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.4",
    "@types/sanitize-html": "^2.16.1",
    "@unocss/astro": "66.8.1",
    "@unocss/eslint-plugin": "66.8.1",
    "@unocss/preset-attributify": "66.8.1",
    "@unocss/reset": "66.8.1",
    "astro-eslint-parser": "^1.4.0",
    "autocorrect-node": "^2.14.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "unocss": "66.8.1",
    "unocss-preset-theme": "^0.14.1",
    "wrangler": "^4.125.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,astro}": "eslint --fix"
  }
}
