// === Git ===
.git/

// === 构建产物 (regenerated per-device) ===
.astro/
.cache/
.temp/
.output/
dist/
.wrangler/
lqip-map.json

// === 本地锁文件 (per-device package manager) ===
package-lock.json
yarn.lock
pnpm-lock.yaml

// === Obsidian / IDE 编辑器状态 (per-device) ===
.obsidian/
.trae/
.idea/
.vscode/

// === 系统/临时文件 ===
.DS_Store*
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~
