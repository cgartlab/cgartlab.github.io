# Web3Forms access key (https://web3forms.com/)
# Replace with your own key before deploying.
PUBLIC_WEB3FORMS_KEY=

# GitHub Personal Access Token (read:user scope) — used for GraphQL contribution data
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Worker 侧 Secret（通过 `wrangler secret put <NAME>` 配置，不走 .env）---
# TG_BOT_TOKEN / TG_CHANNEL_ID — Telegram 频道推送（src/lib/tg.mjs，Cron 每 15 分钟）
# TG_NOTIFY_SECRET — POST /api/tg-notify 手动触发的鉴权头 x-tg-secret（src/worker.mjs）
# 新环境初始化时勿漏配，缺失时 TG 推送会抛错中止（不会误推进推送游标）
