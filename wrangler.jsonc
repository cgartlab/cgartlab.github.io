{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgartlab",
  "main": "src/worker.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    { "pattern": "cgartlab.com", "custom_domain": true },
    { "pattern": "www.cgartlab.com", "custom_domain": true }
  ]
}


