{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgartlab",
  "compatibility_date": "2026-05-02",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "cgartlab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cgartlab.com",
      "custom_domain": true
    }
  ]
}
