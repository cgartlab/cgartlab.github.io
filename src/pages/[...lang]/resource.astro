---
import LinksList from '@/components/LinksList.astro'
import { allLocales, defaultLocale } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { glossary } from '@/data/glossary'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const t = ui[currentLang]
const termCount = glossary.length
const glossaryUrl = `/${currentLang === defaultLocale ? '' : currentLang + '/'}glossary/`
---

<Layout
  postTitle={currentLang === "zh"
    ? "资源与推荐"
    : currentLang === "zh-tw"
    ? "資源與推薦"
    : "Resources - Recommended Links and Tools"}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <div class="mt-6 lg:mt-10.5">
    <LinksList
      lang={currentLang}
      glossaryTitle={t.glossaryTitle}
      glossaryDesc={t.glossaryDesc.replace('{n}', String(termCount))}
      glossaryUrl={glossaryUrl}
      glossaryLinkText={t.glossaryViewAll}
    />
  </div>
</Layout>
