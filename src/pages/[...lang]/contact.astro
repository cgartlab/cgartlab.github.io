---
import InquiryForm from '@/components/InquiryForm.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)

const t = {
  'zh': {
    title: '联系方式 - 合作咨询',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CG艺术实验室',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: '请认真衡量项目的成本和收益，避免急单或比稿，再填写下方表单。',
  },
  'en': {
    title: 'Contact - Collaborations and Inquiries',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CGArtLab',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: 'Please carefully evaluate the cost and benefit of the project, and avoid rush jobs or spec work.',
  },
  'zh-tw': {
    title: '聯繫方式 - 合作諮詢',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CG藝術實驗室',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: '请认真衡量项目的成本和收益，避免急单或比稿，再填写下方表單。',
  },
}

const d = t[currentLang as keyof typeof t] || t.zh
---

<Layout postTitle={d.title}>
  <div class="uno-decorative-line" />

  <article class="heti mt-6 lg:mt-10.5">
    <h1 class="post-title">{d.title}</h1>

    <div class="contact-sections">
      <div class="contact-group">
        <div class="contact-item">
          <span class="contact-label">Email</span>
          <a href={`mailto:${d.email}`} class="contact-value" target="_blank" rel="noopener noreferrer">{d.email}</a>
        </div>
      </div>

      <div class="contact-group">
        <div class="contact-item">
          <span class="contact-label">X (Twitter)</span>
          <a href="https://x.com/cgartlab" class="contact-value" target="_blank" rel="noopener noreferrer">{d.x}</a>
        </div>
        <div class="contact-item">
          <span class="contact-label">GitHub</span>
          <a href={`https://${d.github}`} class="contact-value" target="_blank" rel="noopener noreferrer">{d.github}</a>
        </div>
      </div>

      <div class="contact-group">
        <div class="contact-item">
          <span class="contact-label">WeChat</span>
          <span class="contact-value">{d.wechat}</span>
        </div>
        <div class="contact-item">
          <span class="contact-label">Bilibili</span>
          <a href={`https://${d.bilibili}`} class="contact-value" target="_blank" rel="noopener noreferrer">{d.bilibili}</a>
        </div>
        <div class="contact-item">
          <span class="contact-label">少数派</span>
          <a href={`https://${d.sspai}`} class="contact-value" target="_blank" rel="noopener noreferrer">{d.sspai}</a>
        </div>
      </div>
    </div>

    <blockquote class="contact-note mb-0 mt-6 lg:mt-8">
      <p>{d.note}</p>
    </blockquote>

    <InquiryForm lang={currentLang} />
  </article>
</Layout>

<style>
.contact-sections {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 0;
}

.contact-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid color-mix(in srgb, var(--un-preset-theme-colors-highlight) 10%, transparent);
}

.contact-group:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.375rem 0;
}

.contact-label {
  font-size: 1rem;
  font-weight: 600;
  color: color-mix(in srgb, var(--un-preset-theme-colors-secondary) 60%, transparent);
  text-align: left;
  min-width: 6rem;
}

.contact-value {
  font-size: 1rem;
  color: oklch(var(--un-preset-theme-colors-primary));
  text-decoration: none;
  transition: opacity 0.2s;
  word-break: break-all;
}

.contact-value:hover {
  opacity: 0.7;
}

.contact-note {
  font-size: 0.85rem;
  color: color-mix(in srgb, var(--un-preset-theme-colors-secondary) 65%, transparent);
  margin-top: 1.5rem;
  padding-left: 1rem;
  border-left: 2px solid color-mix(in srgb, var(--un-preset-theme-colors-highlight) 40%, transparent);
}
</style>