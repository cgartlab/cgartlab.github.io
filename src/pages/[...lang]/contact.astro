---
import InquiryForm from '@/components/InquiryForm.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)

const t = {
  zh: {
    title: '联系方式',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CG艺术实验室',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: "请认真衡量项目的成本和收益，避免急单或比稿，再填写下方表单。",
  },
  en: {
    title: 'Contact',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CGArtLab',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: "Please carefully evaluate the cost and benefit of the project, and avoid rush jobs or spec work.",
  },
  'zh-tw': {
    title: '聯繫方式',
    email: 'hello@cgartlab.com',
    github: 'github.com/cgartlab',
    wechat: 'CG藝術實驗室',
    x: '@cgartlab',
    sspai: 'sspai.com/u/cgartlab',
    bilibili: 'space.bilibili.com/38043072',
    note: "请认真衡量项目的成本和收益，避免急单或比稿，再填写下方表單。",
  },
}

const d = t[currentLang as keyof typeof t] || t.zh

const items: { label: string; value: string; url?: string }[] = [
  { label: 'Email', value: d.email, url: `mailto:${d.email}` },
  { label: 'GitHub', value: d.github, url: `https://${d.github}` },
  { label: 'WeChat', value: d.wechat },
  { label: 'X (Twitter)', value: d.x, url: `https://x.com/cgartlab` },
  { label: '少数派', value: d.sspai, url: `https://${d.sspai}` },
  { label: 'Bilibili', value: d.bilibili, url: `https://${d.bilibili}` },
]
---

<Layout postTitle={d.title}>
  <div class="uno-decorative-line" />

  <article class="heti mt-6 lg:mt-10.5">
    <h1 class="post-title">{d.title}</h1>

    <div class="contact-grid">
      {
        items.map(item => (
          <div class="contact-item">
            <span class="contact-label">{item.label}</span>
            {item.url ? (
              <a
                href={item.url}
                class="contact-value"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.value}
              </a>
            ) : (
              <span class="contact-value">{item.value}</span>
            )}
          </div>
        ))
      }
    </div>

    <blockquote class="contact-note mt-6 lg:mt-8 mb-0">
      <p>{d.note}</p>
    </blockquote>

    <InquiryForm lang={currentLang} />
  </article>
</Layout>

<style>
.contact-grid {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0;
  border-bottom: 1px solid oklch(var(--un-preset-theme-colors-highlight) / 0.15);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 1rem;
  font-weight: 600;
  color: oklch(var(--un-preset-theme-colors-secondary) / 0.6);
  text-align: left;
  min-width: 5rem;
}

.contact-value {
  font-size: 1rem;
  color: oklch(var(--un-preset-theme-colors-primary));
  text-decoration: none;
  transition: opacity 0.2s;
}

.contact-value:hover {
  opacity: 0.7;
}

.contact-note {
  font-size: 0.85rem;
  color: oklch(var(--un-preset-theme-colors-secondary) / 0.65);
  margin-top: 1.25rem;
  padding-left: 1rem;
  border-left: 2px solid oklch(var(--un-preset-theme-colors-highlight) / 0.4);
}
</style>