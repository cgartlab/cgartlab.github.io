---
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const searchTitle = currentUI.search || 'Search'
const searchPlaceholder = currentUI.searchPlaceholder || 'Search posts, tags, content...'
const searchEmpty = currentUI.searchEmpty || 'No results found'
---

<Layout postTitle={searchTitle}>
  <div class="uno-decorative-line" />

  <div class="search-page">
    <h1 class="search-page-title">{searchTitle}</h1>

    <div class="search-page-box">
      <div class="search-input-wrapper">
        <input
          type="text"
          id="search-page-input"
          class="search-input"
          placeholder={searchPlaceholder}
          autocomplete="off"
          aria-label={searchTitle}
        />
      </div>
      <div id="search-page-results" class="search-results" aria-live="polite"></div>
      <div id="search-page-empty" class="search-empty">
        <span>{searchEmpty}</span>
      </div>
      <div id="search-page-loading" class="search-loading">
        <div class="search-spinner"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* 独立搜索落地页布局（结果渲染复用全局 .search-* 类，仅补充页面级容器） */
  .search-page {
    max-width: 42rem;
    margin-inline: auto;
    padding-top: 2.5rem;
  }

  .search-page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: oklch(var(--un-preset-theme-colors-primary));
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .search-page-box {
    border: 1px solid
      color-mix(
        in srgb,
        oklch(var(--un-preset-theme-colors-secondary)) 20%,
        transparent
      );
    border-radius: 1rem;
    background-color: oklch(var(--un-preset-theme-colors-background));
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .search-page {
      padding-top: 1.5rem;
    }

    .search-page-title {
      font-size: 1.375rem;
      margin-bottom: 1rem;
    }
  }
</style>

<script is:inline define:vars={{ searchPlaceholder, searchEmpty }}>
(function () {
  const searchIndexCache = new Map()
  const CACHE_TTL = 60 * 60 * 1000
  let searchIndex = []
  let searchIndexLower = []
  let debounceTimer = null
  let inputHandler = null
  let indexPromise = null
  let loadFailed = false

  function normalizeLang(lang) {
    const normalized = (lang || 'zh').toLowerCase()
    if (normalized.startsWith('zh-tw') || normalized.startsWith('zh-hk') || normalized.startsWith('zh-mo'))
      return 'zh-tw'
    if (normalized.startsWith('zh'))
      return 'zh'
    if (normalized.startsWith('en'))
      return 'en'
    return 'zh'
  }

  function getElements() {
    return {
      input: document.getElementById('search-page-input'),
      results: document.getElementById('search-page-results'),
      empty: document.getElementById('search-page-empty'),
      loading: document.getElementById('search-page-loading'),
    }
  }

  function escapeHtml(text) {
    const div = document.createElement('div')
    div.textContent = text
    return div.innerHTML
  }

  function highlight(text, query) {
    if (!query)
      return escapeHtml(text)
    const escaped = escapeHtml(text)
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi')
    return escaped.replace(regex, '<mark>$1</mark>')
  }

  function getExcerpt(lowerContent, cleanContent, query) {
    if (!query)
      return escapeHtml(cleanContent.slice(0, 150))

    const lowerQuery = query.toLowerCase()
    const index = lowerContent.indexOf(lowerQuery)

    if (index === -1)
      return escapeHtml(cleanContent.slice(0, 150))

    const start = Math.max(0, index - 50)
    const end = Math.min(cleanContent.length, index + query.length + 100)
    let excerpt = cleanContent.slice(start, end)

    if (start > 0)
      excerpt = `...${excerpt}`
    if (end < cleanContent.length)
      excerpt = `${excerpt}...`

    return highlight(excerpt, query)
  }

  function formatDate(dateStr) {
    const date = new Date(dateStr)
    return date.toLocaleDateString(document.documentElement.lang || 'zh-CN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }

  async function fetchIndexForLang(lang) {
    const els = getElements()
    if (els.loading)
      els.loading.classList.add('visible')
    try {
      const response = await fetch(`/api/search-index/${lang}.json`)
      const indexData = await response.json()
      const lowerData = indexData.map((item) => {
        const cleanContent = item.content
          .replace(/^---[\s\S]*?---/, '')
          .replace(/[#*`[\]!]/g, '')
          .replace(/\n+/g, ' ')
          .trim()
        return {
          title: item.title.toLowerCase(),
          desc: item.description.toLowerCase(),
          tags: item.tags.map(t => t.toLowerCase()),
          content: item.content.toLowerCase(),
          cleanContent,
          lowerContent: cleanContent.toLowerCase(),
        }
      })
      searchIndexCache.set(lang, { data: indexData, lower: lowerData, ts: Date.now() })
      searchIndex = indexData
      searchIndexLower = lowerData
      loadFailed = false
    }
    catch (error) {
      console.error('Failed to load search index:', error)
      loadFailed = true
    }
    finally {
      const els = getElements()
      if (els.loading)
        els.loading.classList.remove('visible')
    }
  }

  async function loadIndex() {
    const lang = normalizeLang(document.documentElement.lang)
    const now = Date.now()
    for (const [cachedLang, cached] of searchIndexCache) {
      if (now - cached.ts > CACHE_TTL)
        searchIndexCache.delete(cachedLang)
    }
    if (searchIndexCache.has(lang)) {
      const cached = searchIndexCache.get(lang)
      searchIndex = cached.data
      searchIndexLower = cached.lower
      loadFailed = false
      return
    }
    if (!indexPromise)
      indexPromise = fetchIndexForLang(lang).finally(() => { indexPromise = null })
    await indexPromise
  }

  async function search(query) {
    const els = getElements()
    if (!els.results || !els.empty)
      return

    if (!query.trim()) {
      els.results.innerHTML = ''
      els.empty.classList.remove('visible')
      return
    }

    await loadIndex()

    if (loadFailed && searchIndex.length === 0) {
      const span = els.empty.querySelector('span')
      if (span) {
        span.textContent = document.documentElement.lang.startsWith('zh')
          ? '搜索索引加载失败，请刷新页面'
          : 'Search index failed to load, please refresh'
      }
      els.empty.classList.add('visible')
      return
    }

    const lowerQuery = query.toLowerCase().trim()
    const searchResults = []

    for (let i = 0; i < searchIndex.length; i++) {
      const item = searchIndex[i]
      const lower = searchIndexLower[i]

      let score = 0
      const titleMatch = lower.title.includes(lowerQuery)
      const tagMatch = lower.tags.some(t => t.includes(lowerQuery))
      const descMatch = lower.desc.includes(lowerQuery)
      const contentMatch = lower.content.includes(lowerQuery)

      if (titleMatch)
        score += 100
      if (lower.title.startsWith(lowerQuery))
        score += 50
      if (tagMatch)
        score += 80
      if (descMatch)
        score += 30
      if (contentMatch)
        score += 10

      if (score > 0)
        searchResults.push({ item, lower, score })
    }

    searchResults.sort((a, b) => b.score - a.score)
    const topResults = searchResults.slice(0, 20)

    if (topResults.length === 0) {
      els.results.innerHTML = ''
      const span = els.empty.querySelector('span')
      if (span)
        span.textContent = searchEmpty
      els.empty.classList.add('visible')
      return
    }

    els.empty.classList.remove('visible')
    const fragment = document.createDocumentFragment()
    for (let i = 0; i < topResults.length; i++) {
      const { item, lower } = topResults[i]
      const prefix = item.lang === 'zh' ? '' : `/${item.lang}`
      const href = `${prefix}/posts/${item.slug}/`

      const wrapper = document.createElement('a')
      wrapper.href = href
      wrapper.className = 'search-result-item'

      const titleDiv = document.createElement('div')
      titleDiv.className = 'search-result-title'
      titleDiv.innerHTML = highlight(item.title, query)

      const excerptDiv = document.createElement('div')
      excerptDiv.className = 'search-result-excerpt'
      excerptDiv.innerHTML = getExcerpt(lower.lowerContent, lower.cleanContent, query)

      wrapper.appendChild(titleDiv)
      wrapper.appendChild(excerptDiv)

      if (item.tags.length > 0) {
        const tagsDiv = document.createElement('div')
        tagsDiv.className = 'search-result-tags'
        for (let j = 0; j < Math.min(item.tags.length, 5); j++) {
          const tag = document.createElement('span')
          tag.className = 'search-result-tag'
          tag.textContent = item.tags[j]
          tagsDiv.appendChild(tag)
        }
        wrapper.appendChild(tagsDiv)
      }

      const metaDiv = document.createElement('div')
      metaDiv.className = 'search-result-meta'
      const dateSpan = document.createElement('span')
      dateSpan.textContent = formatDate(item.published)
      metaDiv.appendChild(dateSpan)
      wrapper.appendChild(metaDiv)

      fragment.appendChild(wrapper)
    }
    els.results.innerHTML = ''
    els.results.appendChild(fragment)
  }

  function updateUrl(query) {
    const url = new URL(window.location.href)
    if (query)
      url.searchParams.set('q', query)
    else
      url.searchParams.delete('q')
    history.replaceState(null, '', url.toString())
  }

  function setup() {
    const els = getElements()
    if (!els.input)
      return

    // 清理旧监听器，避免重复注册
    if (inputHandler) {
      els.input.removeEventListener('input', inputHandler)
      inputHandler = null
    }

    inputHandler = function () {
      const query = els.input.value
      updateUrl(query)
      if (debounceTimer)
        clearTimeout(debounceTimer)
      debounceTimer = setTimeout(() => {
        search(query)
      }, 150)
    }
    els.input.addEventListener('input', inputHandler)

    // 读取 URL ?q= 参数，自动填充并搜索
    const params = new URLSearchParams(window.location.search)
    const initialQuery = params.get('q') || ''
    els.input.value = initialQuery
    if (initialQuery)
      search(initialQuery)
  }

  function cleanup() {
    const els = getElements()
    if (inputHandler && els.input) {
      els.input.removeEventListener('input', inputHandler)
      inputHandler = null
    }
    if (debounceTimer) {
      clearTimeout(debounceTimer)
      debounceTimer = null
    }
  }

  document.addEventListener('astro:page-load', setup)
  document.addEventListener('astro:before-swap', cleanup)
})()
</script>
