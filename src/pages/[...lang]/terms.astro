---
import Layout from '@/layouts/Layout.astro'
import { allLocales, defaultLocale } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const isDefault = currentLang === defaultLocale
---

<Layout
  postTitle={currentLang === 'zh' ? '服务条款'
    : currentLang === 'zh-tw' ? '服務條款'
    : 'Terms of Service'}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- Terms of Service Page Content -->

  <!-- zh -->
  <div class="heti" lang="zh-CN" style={currentLang === 'zh' ? {} : { display: 'none' }}>
    <h1>服务条款</h1>
    <p><strong>最后更新日期：2026 年 5 月 27 日</strong></p>

    <h2>引言</h2>
    <p>欢迎访问 CG艺术实验室（以下简称"本站"或"我们"）。本服务条款（以下简称"条款"）是您（以下简称"用户"或"您"）与本站之间的法律协议，规定了您访问和使用本站服务的条件和规则。</p>
