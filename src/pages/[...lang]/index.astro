---
import HomeStage from '@/components/Home/HomeStage.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import HomeLayout from '@/layouts/HomeLayout.astro'
import { getRegularPosts, getTotalWordCount } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const t = ui[currentLang as keyof typeof ui] ?? ui.zh

const posts = await getRegularPosts(currentLang)
const words = await getTotalWordCount(currentLang)

const positioning = currentLang === 'zh'
  ? '动态视觉设计 · 数字艺术 · 技术分享'
  : 'Motion design · Digital art · Writing'

const hint = currentLang === 'zh'
  ? '敲击键盘，纸上会一行行打出最新一篇的摘要；点击纸张阅读全文。'
  : 'Type and the sheet prints the latest excerpt line by line; click it to read the whole piece.'

const readout = currentLang === 'zh'
  ? `${posts.length} 篇 · ${words.toLocaleString('zh-CN')} 字`
  : `${posts.length} posts · ${words.toLocaleString('en-US')} words`

const navLinks = [
  { path: '/posts/', label: t.posts },
  { path: '/works/', label: t.works },
  { path: '/column/', label: t.column },
  { path: '/resource/', label: t.links },
  { path: '/tags/', label: t.tags },
].map(item => ({ ...item, href: getLocalizedPath(item.path, currentLang) }))

const latest = posts[0]
const latestHref = latest
  ? getPostPath(latest.data.abbrlink || latest.id, currentLang)
  : getLocalizedPath('/posts/', currentLang)
---

<HomeLayout>
  <div class="home-projection" aria-hidden="true">
    <div class="home-projection-frame">
      <video
        src="/videos/works-loop.webm"
        poster="/videos/works-loop-poster.jpg"
        muted
        loop
        playsinline
        preload="none"
      ></video>
    </div>
    <div class="home-projection-wash"></div>
  </div>

  <main class="home-main" id="home-main">
    <div class="home-copy">
      <h1 class="home-title">{t.subtitle}</h1>
      <p class="home-sub">{positioning}</p>
      {latest && (
        <p class="home-latest">
          <span class="home-latest-label">{currentLang === 'zh' ? '最新' : 'Latest'}</span>
          <a href={latestHref}>{latest.data.title}</a>
        </p>
      )}
    </div>
    <HomeStage lang={currentLang} />
  </main>

  <nav class="home-nav" aria-label={currentLang === 'zh' ? '站内导航' : 'Site sections'}>
    {navLinks.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  <footer class="home-foot">
    <span>{hint}</span>
    <span class="home-readout">{readout}</span>
  </footer>
</HomeLayout>
