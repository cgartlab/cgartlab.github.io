---
import Layout from '@/layouts/Layout.astro'
import { allLocales } from '@/config'
import type { Language } from '@/i18n/config'
import { glossary } from '@/data/glossary'
import { resolveLinkUrl, resolveDescription, resolveTerm } from '@/utils/glossary'
import { getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}


const currentLang = (Astro.params.lang ?? 'zh') as Language
const t = ui[currentLang]

// Use resolved display term for sorting (supports i18n)
const sorted = [...glossary].sort((a, b) => {
  const aTerm = resolveTerm(a, currentLang)
  const bTerm = resolveTerm(b, currentLang)
  return aTerm.localeCompare(bTerm)
})

interface LetterGroup {
  letter: string
  entries: typeof glossary
}

const groups: LetterGroup[] = []
let currentLetter = ''
let currentGroup: LetterGroup | null = null
for (const entry of sorted) {
  const displayTerm = resolveTerm(entry, currentLang)
  const first = displayTerm.charAt(0).toUpperCase()
  const letter = /[A-Za-z]/.test(first) ? first : '#'
  if (!currentGroup) {
    currentGroup = { letter, entries: [] }
    currentLetter = letter
    groups.push(currentGroup)
  } else if (letter !== currentLetter) {
    currentGroup = { letter, entries: [] }
    groups.push(currentGroup)
    currentLetter = letter
  }
  currentGroup.entries.push(entry)
}
---

<Layout>
  <div class="uno-decorative-line" />

  <div class="glossary-page">
    <h1 class="glossary-title">{t.glossaryTitle}</h1>
    <p class="glossary-subtitle">{t.glossaryDesc.replace('{n}', String(glossary.length))}</p>

  <nav class="letter-nav" aria-label={t.glossaryLetterNav}>
    {groups.map(g => (
      <a href={`#letter-${g.letter}`} class="letter-jump" data-letter={g.letter}>{g.letter}</a>
    ))}
  </nav>

    <!-- Glossary Entries with sticky letter headers -->
    <div class="glossary-body">
    {groups.map(group => (
      <section class="letter-section">
        <h2 id={`letter-${group.letter}`} class="letter-header">{group.letter}</h2>
        <ul class="term-list">
          {group.entries.map(entry => {
            const url = resolveLinkUrl(entry, currentLang)
            return (
              <li class="term-item">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-umami-event="glossary-term-click"
                  data-umami-event-term={entry.id}
                >
                  <span class="term-name">
                    {resolveTerm(entry, currentLang)}
                  </span>
                  <span class="term-desc">{resolveDescription(entry, currentLang)}</span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
    </div>
  </div>

  <!-- Letter Jump Nav: phone-contacts style on desktop -->
  
</Layout>

<script>
document.addEventListener('astro:page-load', () => {
  const sections = document.querySelectorAll('.letter-section');
  const links = document.querySelectorAll('.letter-jump');
  if (!sections.length || !links.length) return;

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        links.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
        });
        break;
      }
    }
  }, { rootMargin: '-80px 0px -60% 0px' });

  sections.forEach(s => observer.observe(s));
});
</script>

<style>
.glossary-page {
  max-width: 48rem;
  margin: 0 auto;
  padding: 1rem 0;
}

.glossary-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: oklch(var(--un-preset-theme-colors-primary));
  margin: 0 0 0.25rem;
}

.glossary-subtitle {
  font-size: 0.9rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.7;
  margin: 0 0 1.5rem;
}

/* ─── TOC-style letter nav (sticky horizontal strip) ─── */
.letter-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: oklch(var(--un-preset-theme-colors-background));
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scrollbar-width: none;
  gap: 0.125rem;
  padding: 0.5rem 0;
  margin-bottom: 1.25rem;
  border-bottom: 1px solid color-mix(in srgb, var(--un-preset-theme-colors-secondary) 12%, transparent);
}

.letter-nav::-webkit-scrollbar {
  display: none;
}

.letter-jump {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: oklch(var(--un-preset-theme-colors-secondary) / 0.55);
  text-decoration: none;
  border-radius: 0.25rem;
  transition: all 0.15s;
  scroll-snap-align: center;
}

.letter-jump:hover {
  color: oklch(var(--un-preset-theme-colors-primary));
  background: color-mix(in srgb, var(--un-preset-theme-colors-primary) 10%, transparent);
}

.letter-jump.active {
  color: oklch(var(--un-preset-theme-colors-primary));
  font-weight: 700;
  background: color-mix(in srgb, var(--un-preset-theme-colors-primary) 8%, transparent);
}

/* Desktop: centered wrap layout */
@media (min-width: 1024px) {
  .letter-nav {
    flex-wrap: wrap;
    justify-content: left;
    gap: 0.25rem 0.4rem;
  }

  .letter-jump {
    width: 2rem;
    height: 2rem;
    font-size: 0.8rem;
  }
}

/* Tablet: horizontal scroll */
@media (min-width: 640px) and (max-width: 1023px) {
  .letter-nav {
    gap: 0.2rem;
  }

  .letter-jump {
    width: 2rem;
    height: 2rem;
    font-size: 0.8rem;
  }
}

/* ─── Letter section headers ─── */
.letter-section {
  scroll-margin-top: 3rem;
}

.letter-header {
  font-size: 1.1rem;
  font-weight: 700;
  color: oklch(var(--un-preset-theme-colors-primary));
  margin: 0 0 0.5rem;
  padding: 0.25rem 0;
}

/* ─── Term list ─── */
.term-list {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.term-item {
  padding: 0.375rem 0.5rem;
  border-radius: 0.375rem;
  transition: background 0.15s;
}

.term-item:hover {
  background: color-mix(in srgb, var(--un-preset-theme-colors-primary) 6%, transparent);
}

.term-item a {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  color: inherit;
  text-decoration: none;
  transition: color 0.15s;
}



.term-item a:hover {
  text-decoration: underline;
}

.term-name {
  font-size: 1rem;
  font-weight: 600;
  min-width: 8rem;
  flex-shrink: 0;
  color: oklch(var(--un-preset-theme-colors-primary));
  transition: color 0.15s;
}

.term-desc {
  font-size: 0.875rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.75;
  line-height: 1.4;
  transition: opacity 0.15s;
}

@media (max-width: 640px) {
  .glossary-title {
    font-size: 1.5rem;
  }

  .letter-nav {
    gap: 0;
  }

  .letter-jump {
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.7rem;
  }

  .term-item a {
    flex-direction: column;
    gap: 0.1rem;
  }

  .term-name {
    min-width: auto;
  }
}
</style>