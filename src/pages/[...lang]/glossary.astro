---
import type { Language } from '@/i18n/config'
import { allLocales } from '@/config'
import { glossary } from '@/data/glossary'
import { getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { resolveDescription, resolveLinkUrl, resolveTerm } from '@/utils/glossary'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}


const currentLang = (Astro.params.lang ?? 'zh') as Language
const t = ui[currentLang]

// Use resolved display term for sorting (supports i18n)
const sorted = [...glossary].sort((a, b) => {
  const aTerm = resolveTerm(a, currentLang)
  const bTerm = resolveTerm(b, currentLang)
  return aTerm.localeCompare(bTerm)
})

interface LetterGroup {
  letter: string
  entries: typeof glossary
}

const groups: LetterGroup[] = []
let currentLetter = ''
let currentGroup: LetterGroup | null = null
for (const entry of sorted) {
  const displayTerm = resolveTerm(entry, currentLang)
  const first = displayTerm.charAt(0).toUpperCase()
  const letter = /[A-Z]/i.test(first) ? first : '#'
  if (!currentGroup) {
    currentGroup = { letter, entries: [] }
    currentLetter = letter
    groups.push(currentGroup)
  }
 else if (letter !== currentLetter) {
    currentGroup = { letter, entries: [] }
    groups.push(currentGroup)
    currentLetter = letter
  }
  currentGroup.entries.push(entry)
}
---

<Layout
  postTitle={currentLang === 'zh'
    ? '术语表 - 专业术语索引'
    : currentLang === 'zh-tw'
    ? '術語表 - 專業術語索引'
    : 'Glossary - Technical Terms Reference'}
>
  <div class="uno-decorative-line" />

  <div class="glossary-page">
    <div class="glossary-content">
    <h1 class="glossary-title">{t.glossaryTitle}</h1>
    <p class="glossary-subtitle">{t.glossaryDesc.replace('{n}', String(glossary.length))}</p>
    <p class="glossary-intro">{t.glossaryIntro}</p>
    <p class="glossary-feedback" set:html={t.glossaryFeedback}></p>

  <nav class="letter-nav" aria-label={t.glossaryLetterNav}>
    {groups.map(g => (
      <a href={`#letter-${g.letter}`} class="letter-jump" data-letter={g.letter}>{g.letter}</a>
    ))}
  </nav>

    <!-- Glossary Entries with sticky letter headers -->
<div class="glossary-body">
    {groups.map((group, i) => (
      <section class="letter-section" id={`letter-${group.letter}`}>
        {i > 0 && <div class="letter-divider" aria-hidden="true"></div>}
        <h2 class="letter-header">{group.letter}</h2>
        <ul class="term-list">
          {group.entries.map((entry) => {
            const url = resolveLinkUrl(entry, currentLang)
            return (
              <li class="term-item">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-umami-event="glossary-term-click"
                  data-umami-event-term={entry.id}
                >
                  <span class="term-name">
                    {resolveTerm(entry, currentLang)}
                  </span>
                  <span class="term-desc">{resolveDescription(entry, currentLang)}</span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
    </div>
  </div>
  </div>
</Layout>

<script>
document.addEventListener('astro:page-load', () => {
  const sections = document.querySelectorAll('.letter-section')
  const links = document.querySelectorAll('.letter-jump')
  const nav = document.querySelector('.letter-nav')

  if (!sections.length || !links.length || !nav)
    return

  let clickPending = false

  function setActive(id = '') {
    if (!nav)
      return
    links.forEach(link => link.classList.remove('active'))
    const match = nav.querySelector(`[href="#${id}"]`)
    if (match)
      match.classList.add('active')
  }

  function updateActiveLink(skipReveal = false) {
    if (clickPending || !nav)
      return
    // Desktop: nav is sticky at top → use nav height as offset
    // Mobile: nav is fixed on right → use scroll-margin-top (5rem ≈ 80px) + tolerance
    const navStyle = window.getComputedStyle(nav)
    const isMobile = window.innerWidth < 1024
    const offset = navStyle.position === 'sticky'
      ? Math.max(nav.getBoundingClientRect().height + 8, 84)
      : 84

    // Reveal mobile nav on scroll, reset idle timer
    if (isMobile && !skipReveal)
      revealNav()

    let current = sections[0]?.id || null
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= offset) {
        current = section.id
      }
    }
    if (!current)
      return

    setActive(current)
  }

  // Initial update
  requestAnimationFrame(() => {
    updateActiveLink(true)
  })

  // Update on scroll (throttled via rAF)
  let ticking = false
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveLink()
        ticking = false
      })
      ticking = true
    }
  }, { passive: true })

  // Click letter: instant visual feedback, then scroll event corrects
  links.forEach((link) => {
    link.addEventListener('click', () => {
      // Reveal nav on click (mobile)
      revealNav()
      clickPending = true
      setActive(link.getAttribute('href')?.slice(1) ?? '')
      setTimeout(() => {
        clickPending = false
        updateActiveLink(true)
      }, 400)
    })
  })

  /* ── Mobile auto-hide nav: reveal on scroll, hide after 3s idle ── */
  let idleTimer: ReturnType<typeof setTimeout> | null = null
  let isRevealed = false

  function isMobileLayout() {
    if (!nav)
      return false
    return window.innerWidth < 1024
  }

  function revealNav() {
    if (!nav || !isMobileLayout())
      return
    nav.classList.remove('hiding')
    nav.classList.add('visible')
    isRevealed = true
    resetIdleTimer()
  }

  function resetIdleTimer() {
    if (idleTimer)
      clearTimeout(idleTimer)
    if (!nav)
      return
    idleTimer = setTimeout(() => {
      if (!nav || !isMobileLayout())
        return
      nav.classList.remove('visible')
      nav.classList.add('hiding')
      isRevealed = false
    }, 3000)
  }

  function dismissNav() {
    if (idleTimer)
      clearTimeout(idleTimer)
    if (isRevealed) {
      if (!nav)
        return
      nav.classList.remove('visible')
      nav.classList.add('hiding')
      isRevealed = false
    }
  }

  // Clean up on resize from mobile → desktop
  window.addEventListener('resize', () => {
    dismissNav()
  }, { passive: true })

  // Re-run scroll-spy on window load (catches race conditions in some browsers)
  window.addEventListener('load', () => {
    requestAnimationFrame(() => updateActiveLink(true))
  }, { once: true })
})
</script>

<style>
.glossary-page {
  max-width: 48rem;
  margin: 0 auto;
  padding: 1rem 0;
}

.glossary-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: oklch(var(--un-preset-theme-colors-primary));
  margin: 0 0 0.5rem;
}

.glossary-intro {
  font-size: 0.85rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 65%, transparent);
  line-height: 1.7;
  margin: 0 0 0.75rem;
}

.glossary-feedback {
  font-size: 0.85rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 65%, transparent);
  margin: 0 0 1.5rem;
}

.glossary-feedback a {
  color: oklch(var(--un-preset-theme-colors-primary));
  text-decoration: underline;
  text-underline-offset: 2px;
}

.glossary-subtitle {
  font-size: 0.9rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 70%, transparent);
  margin: 0 0 1rem;
}

/* ─── TOC-style letter nav (sticky horizontal strip) ─── */
.letter-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: oklch(var(--un-preset-theme-colors-background));
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scrollbar-width: none;
  gap: 0.125rem;
  padding: 0.5rem 0;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 12%, transparent);
}

.letter-nav::-webkit-scrollbar {
  display: none;
}

.letter-jump {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: oklch(var(--un-preset-theme-colors-secondary) / 0.55);
  text-decoration: none;
  border-radius: 0.25rem;
  transition: all 0.15s;
  scroll-snap-align: center;
}

.letter-jump:hover {
  color: oklch(var(--un-preset-theme-colors-primary));
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 10%, transparent);
}

.letter-jump.active {
  color: oklch(var(--un-preset-theme-colors-primary));
  font-weight: 700;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 8%, transparent);
}

/* Desktop: centered wrap layout */
@media (min-width: 1024px) {
  .letter-nav {
    flex-wrap: wrap;
    justify-content: left;
    gap: 0.25rem 0.4rem;
  }

  .letter-jump {
    width: 2rem;
    height: 2rem;
    font-size: 0.8rem;
  }
}

/* Tablet: horizontal scroll */
@media (min-width: 640px) and (max-width: 1023px) {
  .letter-nav {
    gap: 0.2rem;
  }

  .letter-jump {
    width: 2rem;
    height: 2rem;
    font-size: 0.8rem;
  }
}

/* ─── Letter section headers ─── */
.letter-section {
  scroll-margin-top: 5rem;
}

.letter-divider {
  height: 1px;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 20%, transparent);
  margin: 1.5rem 0;
}


.letter-header {
  font-size: 1.1rem;
  font-weight: 700;
  color: oklch(var(--un-preset-theme-colors-primary));
  margin: 0 0 0.5rem;
  padding: 0.25rem 0;
}

/* ─── Term list ─── */
.term-list {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.term-item {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
  transition: background 0.15s;
}

.term-item:hover {
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 6%, transparent);
}

.term-item a {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  color: inherit;
  text-decoration: none;
  transition: color 0.15s;
}



.term-item a:hover {
  text-decoration: underline;
}

.term-name {
  font-size: 1rem;
  font-weight: 600;
  min-width: 8rem;
  flex-shrink: 0;
  color: oklch(var(--un-preset-theme-colors-primary));
  transition: color 0.15s;
}

.term-desc {
  font-size: 0.875rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 70%, transparent);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .glossary-title {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .letter-nav {
    gap: 0;
  }

  .letter-jump {
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.7rem;
  }

  .term-item a {
    flex-direction: column;
    gap: 0.1rem;
  }

  .term-name {
    min-width: auto;
  }
}

@media (max-width: 1023px) {
  .letter-nav {
    position: fixed;
    right: 0.75rem;
    top: 50%;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) translateX(calc(100% + 1.5rem));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.35s ease;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.5rem;
    width: auto;
    height: fit-content;
    /* Fallback for browsers without color-mix */
    background-color: oklch(var(--un-preset-theme-colors-background) / 0.85);
    background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 85%, transparent);
    border-radius: 0.5rem;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 10%, transparent);
    box-shadow: 0 2px 12px color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 8%, transparent);
    overflow: visible;
    scrollbar-width: none;
    flex-wrap: nowrap;
    border-bottom: none;
    margin-bottom: 0;
  }

  .letter-jump {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.7rem;
  }

  .letter-nav.visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .letter-nav.hiding {
    transform: translateY(-50%) translateX(calc(100% + 1.5rem));
    opacity: 0;
    pointer-events: none;
  }
}

</style>
