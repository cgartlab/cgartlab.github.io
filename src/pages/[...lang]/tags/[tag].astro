---
import PostList from '@/components/PostList.astro'
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import tagMetaRaw from '@/config/tag-meta.json'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'

interface TagMetaEntry {
  title: string
  description: string
}

type TagMetaMap = Record<string, Record<string, TagMetaEntry>>

const tagMeta: TagMetaMap = tagMetaRaw satisfies TagMetaMap

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag },
      props: { tag },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const posts = await getPostsByTag(tag, currentLang)
const allTags = await getAllTags(currentLang)
const supportedLangs = await getTagSupportedLangs(tag)

const customMeta = tagMeta[tag]?.[currentLang]

const pageTitle = customMeta?.title ?? (currentLang === 'zh'
  ? `标签: ${tag}`
  : currentLang === 'zh-tw'
  ? `標籤: ${tag}`
  : `Tag: ${tag}`)

const pageDescription = customMeta?.description
---

<Layout
  supportedLangs={supportedLangs}
  postTitle={pageTitle}
  postDescription={pageDescription}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- Tag List -->
  <TagList
    tags={allTags}
    currentTag={tag}
    lang={currentLang}
  />

  <!-- Posts List -->
  <PostList
    posts={posts}
    lang={currentLang}
  />
</Layout>
