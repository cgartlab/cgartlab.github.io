---
import { getCollection, render } from 'astro:content'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
// Get privacy page content with different language
const allPrivacyEntries = await getCollection('privacy')
const privacyEntry = allPrivacyEntries.find(entry => entry.data.lang === currentLang)
  ?? allPrivacyEntries.find(entry => entry.data.lang === '')
const { Content } = privacyEntry ? await render(privacyEntry) : { Content: null }
---

<Layout
  postTitle={currentLang === "zh"
    ? "隐私政策 - 个人信息保护"
    : currentLang === "zh-tw"
    ? "隐私政策 - 个人信息保护"
    : "Privacy Policy - Data Protection"}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- Privacy Policy Page Content -->
  <div class="heti">
    {Content && <Content />}
  </div>
</Layout>
