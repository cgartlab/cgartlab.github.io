---
import { defaultLocale, themeConfig } from '@/config'
import { getLangFromPath } from '@/i18n/lang'
import { getTotalWordCount } from '@/utils/content'

const { author } = themeConfig.site
const { links: socialLinks, startYear, showWordCount } = themeConfig.footer

const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear ? startYear : `${startYear}-${currentYear}`

// i18n RSS Feed Path
const currentLang = getLangFromPath(Astro.url.pathname)
const links = socialLinks.filter(({ name }) => name !== 'RSS').map(({ name, url, ...rest }) => {
  if (name === 'Email') {
    return { name, url: url.startsWith('mailto:') ? url : `mailto:${url}`, ...rest }
  }

  return { name, url, ...rest }
})

const footerLinkClass = 'highlight-hover transition-colors after:bottom-0.35em hover:c-primary'

// 获取总字数
let totalWords = 0
if (showWordCount) {
  totalWords = await getTotalWordCount(currentLang)
}

// 字数统计文本
const wordCountText = {
  'zh': '累计发表字数：',
  'en': 'Total published words: ',
  'zh-tw': '累計發表字數：',
}[currentLang] || '累计发表字数：'

const termsPath = currentLang === defaultLocale ? '/terms/' : `/${currentLang}/terms/`
// 免责声明页面路径
const disclaimerPath = currentLang === defaultLocale ? '/disclaimer/' : `/${currentLang}/disclaimer/`
const termsText = {
  'zh': '服务条款',
  'en': 'Terms',
  'zh-tw': '服務條款',
}[currentLang] || '服务条款'

// 免责声明文本
const disclaimerText = {
  'zh': '免责声明',
  'en': 'Disclaimer',
  'zh-tw': '免責聲明',
}[currentLang] || '免责声明'
---

<footer
  class="mb-2 mt-2 box-content h-30 flex flex-col gap-1 text-footer font-navbar"
  lg="uno-desktop-column fixed bottom-24"
>
  <!-- 第1行：社交媒体 -->
  <p class="m-0 text-footer font-navbar">
    {links.map((link, index) => (
      <>
        <a class={footerLinkClass} href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>&nbsp;{index < links.length - 1 && '/'}
      </>
    ))}
  </p>

  <!-- 第2行：累计字数 -->
  {showWordCount && (
    <p class="m-0 text-footer font-navbar">
      {wordCountText}{totalWords.toLocaleString()}
    </p>
  )}

  <!-- 第3行：法律信息 -->
  <p class="m-0 text-footer font-navbar">
    <a class={footerLinkClass} href={termsPath}>{termsText}</a>
    &nbsp; / &nbsp;<a class={footerLinkClass} href={disclaimerPath}>{disclaimerText}</a>
  </p>

  <!-- 第4行：版权 -->
  <p class="m-0 text-footer font-navbar">
    © {year} <a class={footerLinkClass} href="https://cy92.org" target="_blank" rel="noopener noreferrer">{author}</a>
  </p>

  <!-- 第5行：许可 -->
  <p class="m-0 text-footer font-navbar">
    内容统一采用
    <a
      class={footerLinkClass}
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer"
    >
    CC BY-NC-SA 4.0
    </a>
  </p>
</footer>
