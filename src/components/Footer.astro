---
import { defaultLocale, themeConfig } from '@/config'
import { getLangFromPath } from '@/i18n/lang'
import { getTotalWordCount } from '@/utils/content'

const { author } = themeConfig.site
const { links: socialLinks, startYear, showWordCount } = themeConfig.footer

const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear ? startYear : `${startYear}-${currentYear}`

// i18n RSS Feed Path
const currentLang = getLangFromPath(Astro.url.pathname)
const links = socialLinks.filter(({ name }) => name !== 'RSS').map(({ name, url, ...rest }) => {
  if (name === 'Email') {
    return { name, url: url.startsWith('mailto:') ? url : `mailto:${url}`, ...rest }
  }

  return { name, url, ...rest }
})

const footerLinkClass = 'highlight-hover transition-colors after:bottom-0.35em hover:c-primary'

// 获取总字数
let totalWords = 0
if (showWordCount) {
  totalWords = await getTotalWordCount(currentLang)
}

// 字数统计文本
const wordCountText = {
  'zh': '累计发表字数：',
  'en': 'Total published words: ',
  'zh-tw': '累計發表字數：',
}[currentLang] || '累计发表字数：'

// 用户协议：2026-11-17 起《服务条款》《隐私政策》《免责声明》合并为一份文档，
// 页脚只保留这一个入口；旧路径由 src/worker.mjs 301 过来。
const agreementPath = currentLang === defaultLocale ? '/agreement/' : `/${currentLang}/agreement/`
const agreementText = {
  'zh': '用户协议',
  'en': 'User Agreement',
  'zh-tw': '使用者協議',
}[currentLang] || '用户协议'

// Cookie 设置：重新打开同意横幅（ConsentBanner 暴露的 window.__openConsentBanner）
const cookieText = {
  'zh': 'Cookie 设置',
  'en': 'Cookie settings',
  'zh-tw': 'Cookie 設定',
}[currentLang] || 'Cookie 设置'
// 许可协议文本
const licenseText = {
  'zh': '内容统一采用',
  'en': 'All content licensed under',
  'zh-tw': '內容統一採用',
}[currentLang] || '内容统一采用'
---

<footer
  class="mb-2 mt-2 box-content h-30 flex flex-col gap-1 text-footer font-navbar"
  lg="uno-desktop-column fixed bottom-24"
>
  <!-- 第1行：社交媒体 -->
  <p class="m-0 text-footer font-navbar">
    {links.map((link, index) => (
      <>
        <a class={footerLinkClass} href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>&nbsp;{index < links.length - 1 && '/'}
      </>
    ))}
  </p>

  <!-- 第2行：累计字数 -->
  {showWordCount && (
    <p class="m-0 text-footer font-navbar">
      {wordCountText}{totalWords.toLocaleString()}
    </p>
  )}

  <!-- 第3行：法律信息 -->
  <p class="m-0 text-footer font-navbar">
    <a class={footerLinkClass} href={agreementPath}>{agreementText}</a>
    &nbsp; / &nbsp;<button
      type="button"
      class={`${footerLinkClass} cursor-pointer border-0 bg-transparent p-0 text-footer font-navbar`}
      data-consent-open
    >{cookieText}</button>
  </p>

  <!-- 第4行：版权 -->
  <p class="m-0 text-footer font-navbar">
    © {year} <a class={footerLinkClass} href="https://cy92.org" target="_blank" rel="noopener noreferrer">{author}</a>
  </p>

  <!-- 第5行：许可 -->
  <p class="m-0 text-footer font-navbar">
    {licenseText}
    <a
      class={footerLinkClass}
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer"
    >
    CC BY-NC-SA 4.0
    </a>
  </p>
</footer>

<script is:inline>
  (function () {
    // 用户随时可以改同意状态：页脚入口重新打开横幅（PIPL / GDPR 要求的撤回路径）。
    // 必须用 document 级委托：View Transitions 换页会替换页脚 DOM，直接绑在按钮上
    // 第二次客户端导航后就失效了（评审 #522 P1）。
    if (window.__consentOpenBound)
      return
    window.__consentOpenBound = true
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('[data-consent-open]') : null
      if (!el)
        return
      e.preventDefault()
      if (typeof window.__openConsentBanner === 'function')
        window.__openConsentBanner()
    })
  })()
</script>
