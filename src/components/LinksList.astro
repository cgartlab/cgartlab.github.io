---
import LinkCard from '@/components/LinkCard.astro'
import { linksData } from '@/data/links'
import { getLangFromPath } from '@/i18n/lang'

interface Props {
  lang?: string
}

const lang = Astro.props.lang || getLangFromPath(Astro.url.pathname)
const categories = linksData[lang as keyof typeof linksData] || linksData.zh
---


<div class="links-container">
  {Object.entries(categories).map(([category, links]) => (
    <details class="links-section" open>
      <summary class="links-category-title">{category}</summary>
      <div class="links-grid">
        {links.map(link => (
          <LinkCard
            title={link.title}
            description={link.description}
            url={link.url}
            icon={link.icon}
          />
        ))}
      </div>
    </details>
  ))}
</div>

<style>
.links-container {
  width: 100%;
}

.links-section {
  margin-bottom: 1.5rem;
  border-radius: 0.75rem;
  overflow: hidden;
}

.links-section:last-child {
  margin-bottom: 0;
}

.links-category-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
  color: oklch(var(--un-preset-theme-colors-primary));
  position: relative;
  padding: 1rem 1.5rem;
  background: transparent;
  cursor: pointer;
  list-style: none;
  display: block;
  transition: background 0.2s ease;
}

.links-category-title::-webkit-details-marker {
  display: none;
}

.links-section[open] .links-category-title {
  border-bottom: 2px solid oklch(var(--un-preset-theme-colors-primary));
}

.links-section:not([open]) .links-category-title {
  border-bottom: none;
}

.links-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  padding: 1.5rem;
  animation: collapse 0.25s ease-out;
}

@keyframes collapse {
  from {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 640px) {
  .links-grid {
    grid-template-columns: 1fr;
    padding: 1rem;
  }

  .links-category-title {
    font-size: 1.25rem;
    padding: 0.875rem 1rem;
  }
}
</style>