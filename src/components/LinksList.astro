---
import LinkCard from '@/components/LinkCard.astro'
import { linksData } from '@/data/links'
import { getLangFromPath } from '@/i18n/lang'

interface Props {
  lang?: string
  glossaryTitle?: string
  glossaryDesc?: string
  glossaryUrl?: string
  glossaryLinkText?: string
}

const lang = Astro.props.lang || getLangFromPath(Astro.url.pathname)
const categories = linksData[lang as keyof typeof linksData] || linksData.zh
const { glossaryTitle, glossaryDesc, glossaryUrl, glossaryLinkText } = Astro.props
---


<div class="links-container">
  {
    glossaryTitle && (
      <details class="links-section" open>
        <summary class="links-category-title">{glossaryTitle}</summary>
        <div class="glossary-content">
          {glossaryDesc && <p class="glossary-desc">{glossaryDesc}</p>}
          {glossaryUrl && glossaryLinkText && (
            <a href={glossaryUrl} class="glossary-link" data-umami-event="glossary-links-cta">
              {glossaryLinkText}
            </a>
          )}
        </div>
      </details>
    )
  }
  {Object.entries(categories).map(([category, links]) => (
    <details class="links-section">
      <summary class="links-category-title">{category}</summary>
      <div class="links-grid">
        {links.map(link => (
          <LinkCard
            title={link.title}
            description={link.description}
            url={link.url}
            icon={link.icon}
          />
        ))}
      </div>
    </details>
  ))}
</div>

<style>
.links-container {
  width: 100%;
}

.links-section {
  margin-bottom: 1.5rem;
}

.links-section:last-child {
  margin-bottom: 0;
}

.links-category-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
  color: oklch(var(--un-preset-theme-colors-primary));
  position: relative;
  padding: 1rem 0;
  background: transparent;
  cursor: pointer;
  list-style: none;
  display: block;
  transition: background 0.2s ease;
}

.links-category-title::-webkit-details-marker {
  display: none;
}

.links-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  padding: 0;
  animation: collapse 0.25s ease-out;
}

.glossary-content {
  padding: 0 0 1rem 0;
  animation: collapse 0.25s ease-out;
}

.glossary-desc {
  font-size: 0.9rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.75;
  margin: 0 0 1rem;
  line-height: 1.5;
}

.glossary-link {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 600;
  color: oklch(var(--un-preset-theme-colors-primary));
  text-decoration: none;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 10%, transparent);
  transition: all 0.2s;
}

.glossary-link:hover {
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 20%, transparent);
  transform: translateY(-1px);
}

@keyframes collapse {
  from {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 640px) {
  .links-grid {
    grid-template-columns: 1fr;
    padding: 0;
  }

  .links-category-title {
    font-size: 1.25rem;
    padding: 0.875rem 0;
  }

  .glossary-content {
    padding: 0 0 0.75rem 0;
  }
}
</style>
