---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<div id="search-overlay" class="search-overlay" aria-hidden="true">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-container">
    <div class="search-box">
      <div class="search-input-wrapper">
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={currentUI.searchPlaceholder || 'Search...'}
          autocomplete="off"
          aria-label={currentUI.search || 'Search'}
        />
        <button id="search-close" class="search-close" aria-label="Close search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="search-results" class="search-results"></div>
      <div id="search-empty" class="search-empty">
        <span>{currentUI.searchEmpty || 'No results found'}</span>
      </div>
      <div id="search-loading" class="search-loading">
        <div class="search-spinner"></div>
      </div>
    </div>
  </div>
</div>



<script is:inline>
(function () {
  const searchIndexCache = new Map()
  let searchIndex = []
  let searchIndexLower = []
  let debounceTimer = null
  let keydownHandler = null
  let inputHandler = null
  let indexPromise = null
  let lastFocused = null
  const base = document.querySelector('base')?.getAttribute('href') || '/'

  function getElements() {
    return {
      overlay: document.getElementById('search-overlay'),
      input: document.getElementById('search-input'),
      results: document.getElementById('search-results'),
      empty: document.getElementById('search-empty'),
      loading: document.getElementById('search-loading'),
      closeBtn: document.getElementById('search-close'),
      backdrop: document.getElementById('search-backdrop'),
    }
  }

  function open() {
    const els = getElements()
    if (!els.overlay)
      return
    lastFocused = document.activeElement
    els.overlay.classList.add('active')
    els.overlay.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
    // 预加载索引，与 UI 动画并行
    loadIndex()
    setTimeout(() => {
      const currentInput = document.getElementById('search-input')
      if (currentInput)
        currentInput.focus()
    }, 100)
  }

  function close() {
    const els = getElements()
    if (!els.overlay)
      return
    els.overlay.classList.remove('active')
    els.overlay.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    if (els.input)
      els.input.value = ''
    if (els.results)
      els.results.innerHTML = ''
    if (els.empty)
      els.empty.classList.remove('visible')
    if (lastFocused && document.contains(lastFocused))
      lastFocused.focus()
  }

  function normalizeLang(lang) {
    const normalized = (lang || 'zh').toLowerCase()
    if (normalized.startsWith('zh-tw') || normalized.startsWith('zh-hk') || normalized.startsWith('zh-mo'))
      return 'zh-tw'
    if (normalized.startsWith('zh'))
      return 'zh'
    if (normalized.startsWith('en'))
      return 'en'
    return 'zh'
  }

  async function fetchIndexForLang(currentLang) {
    const els = getElements()
    if (els.loading)
      els.loading.classList.add('visible')
    try {
      const response = await fetch(`${base}api/search-index/${currentLang}.json`)
      const indexData = await response.json()
      const lowerData = indexData.map((item) => {
        const cleanContent = item.content
          .replace(/^---[\s\S]*?---/, '')
          .replace(/[#*`[\]!]/g, '')
          .replace(/\n+/g, ' ')
          .trim()
        return {
          title: item.title.toLowerCase(),
          desc: item.description.toLowerCase(),
          tags: item.tags.map(t => t.toLowerCase()),
          content: item.content.toLowerCase(),
          cleanContent,
          lowerContent: cleanContent.toLowerCase(),
        }
      })
      searchIndexCache.set(currentLang, { data: indexData, lower: lowerData })
      searchIndex = indexData
      searchIndexLower = lowerData
    }
    catch (error) {
      console.error('Failed to load search index:', error)
    }
    finally {
      const els = getElements()
      if (els.loading)
        els.loading.classList.remove('visible')
    }
  }

  async function loadIndex() {
    const currentLang = normalizeLang(document.documentElement.lang)
    if (searchIndexCache.has(currentLang)) {
      const cached = searchIndexCache.get(currentLang)
      searchIndex = cached.data
      searchIndexLower = cached.lower
      return
    }
    if (!indexPromise) {
      indexPromise = fetchIndexForLang(currentLang).finally(() => { indexPromise = null })
    }
    await indexPromise
  }

  function escapeHtml(text) {
    const div = document.createElement('div')
    div.textContent = text
    return div.innerHTML
  }

  function highlight(text, query) {
    if (!query)
      return escapeHtml(text)
    const escaped = escapeHtml(text)
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi')
    return escaped.replace(regex, '<mark>$1</mark>')
  }

  function getExcerpt(lowerContent, cleanContent, query) {
    if (!query) {
      return escapeHtml(cleanContent.slice(0, 150))
    }

    const lowerQuery = query.toLowerCase()
    const index = lowerContent.indexOf(lowerQuery)

    if (index === -1) {
      return escapeHtml(cleanContent.slice(0, 150))
    }

    const start = Math.max(0, index - 50)
    const end = Math.min(cleanContent.length, index + query.length + 100)
    let excerpt = cleanContent.slice(start, end)

    if (start > 0)
      excerpt = `...${excerpt}`
    if (end < cleanContent.length)
      excerpt = `${excerpt}...`

    return highlight(excerpt, query)
  }

  function formatDate(dateStr) {
    const date = new Date(dateStr)
    return date.toLocaleDateString(document.documentElement.lang || 'zh-CN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }

  async function search(query) {
    const els = getElements()
    if (!els.results || !els.empty)
      return

    if (!query.trim()) {
      els.results.innerHTML = ''
      els.empty.classList.remove('visible')
      return
    }

    await loadIndex()

    const lowerQuery = query.toLowerCase().trim()
    const searchResults = []

    for (let i = 0; i < searchIndex.length; i++) {
      const item = searchIndex[i]
      const lower = searchIndexLower[i]

      let score = 0
      const titleMatch = lower.title.includes(lowerQuery)
      const tagMatch = lower.tags.some(t => t.includes(lowerQuery))
      const descMatch = lower.desc.includes(lowerQuery)
      const contentMatch = lower.content.includes(lowerQuery)

      if (titleMatch)
        score += 100
      if (lower.title.startsWith(lowerQuery))
        score += 50
      if (tagMatch)
        score += 80
      if (descMatch)
        score += 30
      if (contentMatch)
        score += 10

      if (score > 0) {
        searchResults.push({ item, score })
      }
    }

    searchResults.sort((a, b) => {
      return b.score - a.score
    })
    const topResults = searchResults.slice(0, 20)

    if (topResults.length === 0) {
      els.results.innerHTML = ''
      els.empty.classList.add('visible')
      return
    }

    els.empty.classList.remove('visible')
    const fragment = document.createDocumentFragment()
    for (let i = 0; i < topResults.length; i++) {
      const item = topResults[i].item
      const prefix = item.lang === 'zh' ? '' : `/${item.lang}`
      const href = `${prefix}/posts/${item.slug}/`
      const fullHref = base.replace(/\/$/, '') + href

      const wrapper = document.createElement('a')
      wrapper.href = fullHref
      wrapper.className = 'search-result-item'

      const titleDiv = document.createElement('div')
      titleDiv.className = 'search-result-title'
      titleDiv.innerHTML = highlight(item.title, query)

      const excerptDiv = document.createElement('div')
      excerptDiv.className = 'search-result-excerpt'
      excerptDiv.innerHTML = getExcerpt(lower.lowerContent, lower.cleanContent, query)

      wrapper.appendChild(titleDiv)
      wrapper.appendChild(excerptDiv)

      if (item.tags.length > 0) {
        const tagsDiv = document.createElement('div')
        tagsDiv.className = 'search-result-tags'
        for (let j = 0; j < Math.min(item.tags.length, 5); j++) {
          const tag = document.createElement('span')
          tag.className = 'search-result-tag'
          tag.textContent = item.tags[j]
          tagsDiv.appendChild(tag)
        }
        wrapper.appendChild(tagsDiv)
      }

      const metaDiv = document.createElement('div')
      metaDiv.className = 'search-result-meta'
      const dateSpan = document.createElement('span')
      dateSpan.textContent = formatDate(item.published)
      metaDiv.appendChild(dateSpan)
      wrapper.appendChild(metaDiv)

      wrapper.addEventListener('click', () => close())
      fragment.appendChild(wrapper)
    }
    els.results.innerHTML = ''
    els.results.appendChild(fragment)
  }

  function setupEventListeners() {
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler)
    }

    keydownHandler = function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault()
        open()
      }
      const els = getElements()
      if (e.key === 'Escape' && els.overlay && els.overlay.classList.contains('active')) {
        close()
      }
    }
    document.addEventListener('keydown', keydownHandler)

    const els = getElements()
    if (els.closeBtn) {
      els.closeBtn.onclick = close
    }
    if (els.backdrop) {
      els.backdrop.onclick = close
    }

    if (els.input) {
      if (inputHandler) {
        els.input.removeEventListener('input', inputHandler)
      }
      inputHandler = function () {
        if (debounceTimer)
          clearTimeout(debounceTimer)
        debounceTimer = setTimeout(() => {
          const currentInput = document.getElementById('search-input')
          if (currentInput)
            search(currentInput.value)
        }, 150)
      }
      els.input.addEventListener('input', inputHandler)
    }
  }

  function bindSearchTriggers() {
    const triggers = ['search-trigger', 'search-trigger-mobile']
    triggers.forEach((id) => {
      const el = document.getElementById(id)
      if (el) {
        el.onclick = function (e) {
          e.preventDefault()
          open()
        }
      }
    })
  }

  function init() {
    setupEventListeners()
    bindSearchTriggers()
  }

  document.addEventListener('astro:page-load', init)
})()
</script>
