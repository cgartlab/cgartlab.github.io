---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search" aria-hidden="true" inert>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-container">
    <div class="search-box">
      <div class="search-input-wrapper">
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={currentUI.searchPlaceholder || 'Search...'}
          autocomplete="off"
          aria-label={currentUI.search || 'Search'}
        />
        <button id="search-close" class="search-close" aria-label="Close search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="search-results" class="search-results" aria-live="polite"></div>
      <div id="search-empty" class="search-empty" data-empty-text={currentUI.searchEmpty || 'No results found'}>
        <span>{currentUI.searchEmpty || 'No results found'}</span>
      </div>
      <div id="search-loading" class="search-loading">
        <div class="search-spinner"></div>
      </div>
    </div>
  </div>
</div>



<script is:inline>
// 脚本内容必须与语言无关：View Transition 下本脚本为 is:inline（每次导航重新
// 执行），用守卫标志保证 doc 级监听器只注册一次，避免 N 次导航累积 N 份监听器。
// 本地化文案通过 #search-empty[data-empty-text] 在运行时读取。
(function () {
  if (window.__SEARCH_GLOBAL_SETUP)
    return
  window.__SEARCH_GLOBAL_SETUP = true

  const searchIndexCache = new Map()
  const CACHE_TTL = 60 * 60 * 1000
  // 搜索行为参数：两边都是 is:inline 脚本，无法 import 共享模块，故在此显式命名。
  // SYNC: 改动需同步 src/pages/[...lang]/search.astro 中的同名常量。
  const DEBOUNCE_MS = 150
  const MAX_RESULTS = 20
  const EXCERPT_LENGTH = 150
  const EXCERPT_CONTEXT_BEFORE = 50
  const EXCERPT_CONTEXT_AFTER = 100
  let searchIndex = []
  let searchIndexLower = []
  let debounceTimer = null
  let keydownHandler = null
  let inputHandler = null
  let indexPromise = null
  let lastFocused = null
  let scrollY = 0
  let loadFailed = false
  // is:inline 脚本不经过 Vite 编译，import.meta.env 不会被替换、且在 classic
  // script 中直接使用会抛 SyntaxError（导致整个脚本不执行）。改为运行时从
  // <base> 标签读取 base URL（由 Head.astro 输出），fallback 到 '/'。
  const base = document.querySelector('base')?.getAttribute('href') || '/'

  function getElements() {
    return {
      overlay: document.getElementById('search-overlay'),
      input: document.getElementById('search-input'),
      results: document.getElementById('search-results'),
      empty: document.getElementById('search-empty'),
      loading: document.getElementById('search-loading'),
      closeBtn: document.getElementById('search-close'),
      backdrop: document.getElementById('search-backdrop'),
    }
  }

  function open() {
    const els = getElements()
    if (!els.overlay)
      return
    lastFocused = document.activeElement
    els.overlay.classList.add('active')
    els.overlay.removeAttribute('inert')
    els.overlay.setAttribute('aria-hidden', 'false')
    scrollY = window.scrollY
    document.body.style.top = `-${scrollY}px`
    document.body.classList.add('scroll-lock')
    // 预加载索引，与 UI 动画并行
    loadIndex()
    setTimeout(() => {
      const currentInput = document.getElementById('search-input')
      if (currentInput)
        currentInput.focus()
    }, 100)
  }

  function close() {
    const els = getElements()
    if (!els.overlay)
      return
    els.overlay.classList.remove('active')
    els.overlay.setAttribute('inert', '')
    els.overlay.setAttribute('aria-hidden', 'true')
    document.body.classList.remove('scroll-lock')
    document.body.style.top = ''
    window.scrollTo(0, scrollY)
    if (els.input)
      els.input.value = ''
    if (els.results)
      els.results.innerHTML = ''
    if (els.empty)
      els.empty.classList.remove('visible')
    if (lastFocused && document.contains(lastFocused))
      lastFocused.focus()
  }

  function normalizeLang(lang) {
    const normalized = (lang || 'zh').toLowerCase()
    if (normalized.startsWith('zh-tw') || normalized.startsWith('zh-hk') || normalized.startsWith('zh-mo'))
      return 'zh-tw'
    if (normalized.startsWith('zh'))
      return 'zh'
    if (normalized.startsWith('en'))
      return 'en'
    return 'zh'
  }

  async function fetchIndexForLang(currentLang) {
    const els = getElements()
    if (els.loading)
      els.loading.classList.add('visible')
    const controller = new AbortController()
    const timer = setTimeout(() => controller.abort(), 10_000)
    try {
      const response = await fetch(`${base}api/search-index/${currentLang}.json`, {
        signal: controller.signal,
      })
      const indexData = await response.json()
      const lowerData = indexData.map((item) => {
        // 清理 Markdown 语法，避免摘录残留 (_images/xxx.webp)、裸 URL 等噪声。
        // 顺序敏感：图片必须在链接之前替换（图片本身也是 [x](y) 形式）。
        const cleanContent = item.content
          .replace(/^---[\s\S]*?---/, '')
          // 图片 ![alt](url) → alt
          .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
          // 链接 [text](url) → text
          .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
          // 行内代码 `code` → code
          .replace(/`([^`]*)`/g, '$1')
          // 裸 URL
          .replace(/https?:\/\/[^\s)]+/g, '')
          // 残留 Markdown 标记（标题井号、加粗星号、引用符、分隔线等）
          .replace(/[#*`[\]!>_|~]/g, '')
          .replace(/\n+/g, ' ')
          .trim()
        return {
          title: item.title.toLowerCase(),
          desc: item.description.toLowerCase(),
          tags: item.tags.map(t => t.toLowerCase()),
          content: cleanContent.toLowerCase(),
          cleanContent,
          lowerContent: cleanContent.toLowerCase(),
        }
      })
      searchIndexCache.set(currentLang, { data: indexData, lower: lowerData, ts: Date.now() })
      searchIndex = indexData
      searchIndexLower = lowerData
      loadFailed = false
    }
    catch (error) {
      console.error('Failed to load search index:', error)
      loadFailed = true
    }
    finally {
      clearTimeout(timer)
      const els = getElements()
      if (els.loading)
        els.loading.classList.remove('visible')
    }
  }

  async function loadIndex() {
    const currentLang = normalizeLang(document.documentElement.lang)
    // 过期清理：缓存超过 1 小时后强制刷新，保证新文章尽快进入搜索索引
    const now = Date.now()
    for (const [lang, cached] of searchIndexCache) {
      if (now - cached.ts > CACHE_TTL)
        searchIndexCache.delete(lang)
    }
    if (searchIndexCache.has(currentLang)) {
      const cached = searchIndexCache.get(currentLang)
      searchIndex = cached.data
      searchIndexLower = cached.lower
      loadFailed = false
      return
    }
    if (!indexPromise) {
      indexPromise = fetchIndexForLang(currentLang).finally(() => {
        indexPromise = null
      })
    }
    await indexPromise
  }

  function escapeHtml(text) {
    const div = document.createElement('div')
    div.textContent = text
    return div.innerHTML
  }

  function highlight(text, query) {
    if (!query)
      return escapeHtml(text)
    const escaped = escapeHtml(text)
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi')
    return escaped.replace(regex, '<mark>$1</mark>')
  }

  function getExcerpt(lowerContent, cleanContent, query) {
    if (!query) {
      return escapeHtml(cleanContent.slice(0, EXCERPT_LENGTH))
    }

    const lowerQuery = query.toLowerCase()
    const index = lowerContent.indexOf(lowerQuery)

    if (index === -1) {
      return escapeHtml(cleanContent.slice(0, EXCERPT_LENGTH))
    }

    const start = Math.max(0, index - EXCERPT_CONTEXT_BEFORE)
    const end = Math.min(cleanContent.length, index + query.length + EXCERPT_CONTEXT_AFTER)
    let excerpt = cleanContent.slice(start, end)

    if (start > 0)
      excerpt = `...${excerpt}`
    if (end < cleanContent.length)
      excerpt = `${excerpt}...`

    return highlight(excerpt, query)
  }

  function formatDate(dateStr) {
    const date = new Date(dateStr)
    return date.toLocaleDateString(document.documentElement.lang || 'zh-CN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }

  async function search(query) {
    const els = getElements()
    if (!els.results || !els.empty)
      return

    if (!query.trim()) {
      els.results.innerHTML = ''
      els.empty.classList.remove('visible')
      return
    }

    await loadIndex()

    if (loadFailed) {
      const span = els.empty?.querySelector('span')
      if (span) {
        span.textContent = searchIndex.length === 0
          ? (document.documentElement.lang.startsWith('zh')
              ? '搜索索引加载失败，请刷新页面'
              : 'Search index failed to load, please refresh')
          : (document.documentElement.lang.startsWith('zh')
              ? '索引更新失败，当前显示缓存结果'
              : 'Index update failed, showing cached results')
      }
      if (searchIndex.length === 0) {
        els.empty.classList.add('visible')
        return
      }
    }

    const lowerQuery = query.toLowerCase().trim()
    const searchResults = []

    for (let i = 0; i < searchIndex.length; i++) {
      const item = searchIndex[i]
      const lower = searchIndexLower[i]

      let score = 0
      const titleMatch = lower.title.includes(lowerQuery)
      const tagMatch = lower.tags.some(t => t.includes(lowerQuery))
      const descMatch = lower.desc.includes(lowerQuery)
      const contentMatch = lower.content.includes(lowerQuery)

      if (titleMatch)
        score += 100
      if (lower.title.startsWith(lowerQuery))
        score += 50
      if (tagMatch)
        score += 80
      if (descMatch)
        score += 30
      if (contentMatch)
        score += 10

      if (score > 0) {
        searchResults.push({ item, lower, score })
      }
    }

    searchResults.sort((a, b) => {
      return b.score - a.score
    })
    const topResults = searchResults.slice(0, MAX_RESULTS)

    if (topResults.length === 0) {
      els.results.innerHTML = ''
      const span = els.empty?.querySelector('span')
      if (span)
        span.textContent = els.empty.dataset.emptyText || span.textContent
      els.empty.classList.add('visible')
      return
    }

    els.empty.classList.remove('visible')
    const fragment = document.createDocumentFragment()
    for (let i = 0; i < topResults.length; i++) {
      const { item, lower } = topResults[i]
      const prefix = item.lang === 'zh' ? '' : `/${item.lang}`
      const href = `${prefix}/posts/${item.slug}/`
      const fullHref = base.replace(/\/$/, '') + href

      const wrapper = document.createElement('a')
      wrapper.href = fullHref
      wrapper.className = 'search-result-item'

      const titleDiv = document.createElement('div')
      titleDiv.className = 'search-result-title'
      titleDiv.innerHTML = highlight(item.title, query)

      const excerptDiv = document.createElement('div')
      excerptDiv.className = 'search-result-excerpt'
      excerptDiv.innerHTML = getExcerpt(lower.lowerContent, lower.cleanContent, query)

      wrapper.appendChild(titleDiv)
      wrapper.appendChild(excerptDiv)

      if (item.tags.length > 0) {
        const tagsDiv = document.createElement('div')
        tagsDiv.className = 'search-result-tags'
        for (let j = 0; j < Math.min(item.tags.length, 5); j++) {
          const tag = document.createElement('span')
          tag.className = 'search-result-tag'
          tag.textContent = item.tags[j]
          tagsDiv.appendChild(tag)
        }
        wrapper.appendChild(tagsDiv)
      }

      const metaDiv = document.createElement('div')
      metaDiv.className = 'search-result-meta'
      const dateSpan = document.createElement('span')
      dateSpan.textContent = formatDate(item.published)
      metaDiv.appendChild(dateSpan)
      wrapper.appendChild(metaDiv)

      wrapper.addEventListener('click', () => close())
      fragment.appendChild(wrapper)
    }
    els.results.innerHTML = ''
    els.results.appendChild(fragment)
  }

  function setupEventListeners() {
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler)
    }

    keydownHandler = function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault()
        open()
      }
      const els = getElements()
      if (e.key === 'Escape' && els.overlay && els.overlay.classList.contains('active')) {
        close()
      }
      if (e.key === 'Tab' && els.overlay && els.overlay.classList.contains('active')) {
        const resultLinks = els.results ? Array.from(els.results.querySelectorAll('a[href]')) : []
        const focusables = [els.input, els.closeBtn, ...resultLinks].filter(Boolean)
        if (focusables.length < 2)
          return
        const first = focusables[0]
        const last = focusables.at(-1)
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        }
        else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    }
    document.addEventListener('keydown', keydownHandler)

    const els = getElements()
    if (els.closeBtn) {
      els.closeBtn.onclick = close
    }
    if (els.backdrop) {
      els.backdrop.onclick = close
    }

    if (els.input) {
      if (inputHandler) {
        els.input.removeEventListener('input', inputHandler)
      }
      inputHandler = function () {
        if (debounceTimer)
          clearTimeout(debounceTimer)
        debounceTimer = setTimeout(() => {
          const currentInput = document.getElementById('search-input')
          if (currentInput)
            search(currentInput.value)
        }, DEBOUNCE_MS)
      }
      els.input.addEventListener('input', inputHandler)
    }
  }

  function bindSearchTriggers() {
    const triggers = ['search-trigger', 'search-trigger-mobile']
    triggers.forEach((id) => {
      const el = document.getElementById(id)
      if (el) {
        el.onclick = function (e) {
          e.preventDefault()
          open()
        }
      }
    })
  }

  function init() {
    setupEventListeners()
    bindSearchTriggers()
  }

  function cleanup() {
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler)
      keydownHandler = null
    }
    if (inputHandler && document.getElementById('search-input')) {
      document.getElementById('search-input').removeEventListener('input', inputHandler)
      inputHandler = null
    }
    if (debounceTimer) {
      clearTimeout(debounceTimer)
      debounceTimer = null
    }
  }

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', cleanup)
  // 立即初始化，不等待 astro:page-load：该事件由 window.load 派发，会被
  // GA / Giscus / Umami / Cloudflare Insights 等第三方脚本阻塞 2-8s，期间
  // 用户点击"搜索"无反应。init() 内的 setupEventListeners() 已先清理旧
  // 监听器再注册，故与 astro:page-load 的重复调用幂等。
  init()
})()
</script>
