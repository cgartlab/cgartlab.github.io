---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<div id="consent-banner" class="consent-banner" role="region" aria-label={currentUI.consentTitle || 'Cookie Consent'} aria-describedby="consent-description" aria-hidden="true">
  <div class="consent-bar">
    <div class="consent-bar-inner">
      <div class="consent-text">
        <h2 class="consent-title">{currentUI.consentTitle || 'Cookie Consent'}</h2>
        <p id="consent-description" class="consent-description">{currentUI.consentDescription || 'We use cookies to analyze site traffic and improve your experience.'}</p>
      </div>
      <div class="consent-actions">
        <button id="consent-reject" class="consent-btn consent-btn-ghost">{currentUI.consentReject || 'Reject All'}</button>
        <button id="consent-functional" class="consent-btn consent-btn-outline">{currentUI.consentFunctional || 'Functional Only'}</button>
        <button id="consent-accept" class="consent-btn consent-btn-primary">{currentUI.consentAccept || 'Accept All'}</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── bottom banner wrapper ──────────────────────────── */
  .consent-banner {
    position: fixed;
    z-index: 9000;
    bottom: 0;
    left: 0;
    right: 0;
    visibility: hidden;
    transform: translateY(100%);
    transition:
      transform 0.5s cubic-bezier(0.19, 1, 0.22, 1),
      visibility 0s 0.5s;
  }

  .consent-banner.visible {
    visibility: visible;
    transform: translateY(0);
    transition:
      transform 0.5s cubic-bezier(0.19, 1, 0.22, 1),
      visibility 0s;
  }

  /* ── frosted glass bar (square edges, semi-transparent) ── */
  .consent-bar {
    /* Horizontal spacing matches page wrapper:
       desktop: mx-[max(5.75rem,calc(50vw-34.25rem))]
       mobile:  x-[min(7.25vw,3.731rem)]
       (padding on the bar keeps inner content in exact page-wrapper position) */
    padding: 0.5rem max(5.75rem, calc(50vw - 34.25rem));
    border-radius: 0;
    /* Frosted glass matching .search-box: gradient + backdrop-filter blur.
       backdrop-filter is the banner's own glass surface, not a page overlay. */
    background: linear-gradient(
      135deg,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 92%, transparent) 0%,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 82%, transparent) 50%,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 72%, transparent) 100%
    );
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    backdrop-filter: blur(40px) saturate(200%);
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.10);
    box-shadow:
      0 -4px 20px oklch(var(--un-preset-theme-colors-primary) / 0.05),
      0 -1px 3px oklch(var(--un-preset-theme-colors-primary) / 0.03);
    overflow: hidden;
  }

  /* ── inner content: width follows page responsive layout ── */
  .consent-bar-inner {
    /* Block-level default fills parent content width; max-width constrains
       it so text/buttons don't stretch wider than the page wrapper does. */
    max-width: min(calc(75vw - 16rem), 44rem);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 1023px) {
    .consent-bar {
      padding: 0.5rem min(7.25vw, 3.731rem);
    }
    .consent-bar-inner {
      max-width: none;
    }
  }

  /* ── text ───────────────────────────────────────────── */
  .consent-text {
    flex: 1;
    min-width: 0;
  }

  .consent-title {
    font-size: 0.75rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.01em;
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .consent-description {
    font-size: 0.625rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.7);
    line-height: 1.4;
    margin: 0;
  }

  /* ── actions ────────────────────────────────────────── */
  .consent-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .consent-btn {
    /* All buttons share same base size; per-variant tweaks below
       compensate for the visual-weight illusion created by fill/color. */
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
    border: 1px solid transparent;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .consent-btn:active {
    transform: scale(0.97);
  }

  .consent-btn-ghost {
    background: transparent;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.55);
    border-color: oklch(var(--un-preset-theme-colors-secondary) / 0.18);
  }
  .consent-btn-ghost:hover {
    background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 7%, transparent);
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.85);
  }

  .consent-btn-outline {
    background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 12%, transparent);
    color: oklch(var(--un-preset-theme-colors-secondary));
    border-color: oklch(var(--un-preset-theme-colors-secondary) / 0.2);
  }
  .consent-btn-outline:hover {
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.16);
  }

  .consent-btn-primary {
    background: oklch(var(--un-preset-theme-colors-primary));
    color: oklch(var(--un-preset-theme-colors-background));
    border-color: oklch(var(--un-preset-theme-colors-primary));
    box-shadow: 0 1px 4px oklch(var(--un-preset-theme-colors-primary) / 0.15);
  }
  .consent-btn-primary:hover {
    background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 72%, oklch(var(--un-preset-theme-colors-background)));
    box-shadow: 0 2px 8px oklch(var(--un-preset-theme-colors-primary) / 0.25);
  }

  .consent-btn:focus-visible {
    outline: 2px solid oklch(var(--un-preset-theme-colors-highlight) / 0.6);
    outline-offset: 2px;
  }

  /* ── responsive ─────────────────────────────────────── */
  @media (max-width: 768px) {
    .consent-bar-inner {
      flex-direction: column;
      gap: 0.5rem;
      align-items: stretch;
    }
    .consent-title {
      font-size: 0.75rem;
    }
    .consent-description {
      font-size: 0.625rem;
    }
    .consent-actions {
      gap: 0.25rem;
    }
    .consent-btn {
      flex: 1;
      min-width: 0;
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .consent-actions {
      flex-direction: column;
      gap: 0.25rem;
    }
    .consent-btn {
      width: 100%;
    }
  }

  /* ── reduced motion ────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .consent-banner,
    .consent-banner * {
      transition-duration: 0.01ms !important;
    }
  }

  :global(html.reduce-motion) .consent-banner,
  :global(html.reduce-motion) .consent-banner * {
    transition-duration: 0.01ms !important;
  }

  /* ── dark mode ──────────────────────────────────────── */
  html.dark .consent-bar {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 62%, transparent) 0%,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 48%, transparent) 50%,
      color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 36%, transparent) 100%
    );
    -webkit-backdrop-filter: blur(40px) saturate(150%);
    backdrop-filter: blur(40px) saturate(150%);
    border-top: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.06);
    box-shadow:
      0 -4px 20px oklch(var(--un-preset-theme-colors-primary) / 0.04),
      0 -1px 3px oklch(var(--un-preset-theme-colors-primary) / 0.02);
  }
</style>

<script is:inline>
(function () {
  'use strict'

  var STORAGE_KEY = 'consent-preference'

  function loadPref() {
    try { return localStorage.getItem(STORAGE_KEY) }
    catch { return null }
  }

  function savePref(pref) {
    try { localStorage.setItem(STORAGE_KEY, pref) }
    catch { /* private browsing */ }
  }

  function getBanner() { return document.getElementById('consent-banner') }

  function showBanner(banner) {
    if (!banner || banner.classList.contains('visible')) return
    banner.classList.add('visible')
    banner.setAttribute('aria-hidden', 'false')
    // Move focus to the first button for keyboard users (WCAG 2.4.3)
    var firstBtn = document.getElementById('consent-reject')
    if (firstBtn) firstBtn.focus()
  }

  function hideBanner(banner) {
    if (!banner || !banner.classList.contains('visible')) return
    banner.classList.remove('visible')
    banner.setAttribute('aria-hidden', 'true')
  }

  function setPreference(pref) {
    savePref(pref)
    window.__CONSENT_STATUS = pref
    hideBanner(getBanner())
  }

  function bindButtons() {
    var ids = ['consent-reject', 'consent-functional', 'consent-accept']
    var vals = ['rejected', 'functional', 'accepted']
    for (var i = 0; i < 3; i++) {
      var btn = document.getElementById(ids[i])
      if (btn) btn.addEventListener('click', setPreference.bind(null, vals[i]))
    }
  }

  function initBanner() {
    var banner = getBanner()
    if (!banner) return

    var pref = loadPref()
    if (!pref) {
      showBanner(banner)
    } else {
      window.__CONSENT_STATUS = pref
    }
    bindButtons()
  }

  if (!window.__CONSENT_GLOBAL_SETUP) {
    window.__CONSENT_GLOBAL_SETUP = true
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var b = getBanner()
        if (b && b.classList.contains('visible')) setPreference('rejected')
      }
    })
  }

  initBanner()
})()
</script>
