---
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-label="Cookie Consent" aria-hidden="true">
  <div class="consent-content">
    <h2 class="consent-title">Cookie Consent</h2>
    <p class="consent-description">We use cookies to analyze site traffic and improve your experience.</p>
    <div class="consent-buttons">
      <button id="consent-reject" class="consent-btn consent-btn-reject">
        Reject All
      </button>
      <button id="consent-functional" class="consent-btn consent-btn-functional">
        Functional Only
      </button>
      <button id="consent-accept" class="consent-btn consent-btn-accept">
        Accept All
      </button>
    </div>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9000;
    background: #ffffff;
    border-top: 1px solid #e5e5e5;
    padding: 1rem 1.5rem;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .consent-banner.visible {
    transform: translateY(0);
  }

  .consent-content {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .consent-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333333;
  }

  .consent-description {
    font-size: 0.875rem;
    color: #666666;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .consent-buttons {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .consent-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
    border: 1px solid #e5e5e5;
  }

  .consent-btn:hover {
    opacity: 0.9;
  }

  .consent-btn:active {
    transform: scale(0.98);
  }

  .consent-btn-reject {
    background: transparent;
    color: #666666;
  }

  .consent-btn-functional {
    background: #e5e5e5;
    color: #333333;
  }

  .consent-btn-accept {
    background: #007bff;
    color: #ffffff;
  }

  .consent-banner:focus-within {
    outline: 2px solid #007bff;
    outline-offset: 2px;
  }
</style>

<script is:inline>
(function () {
  var STORAGE_KEY = 'consent-preference'
  var banner = document.getElementById('consent-banner')

  function showBanner() {
    if (banner) {
      banner.classList.add('visible')
      banner.setAttribute('aria-hidden', 'false')
    }
  }

  function hideBanner() {
    if (banner) {
      banner.classList.remove('visible')
      banner.setAttribute('aria-hidden', 'true')
    }
  }

  function setPreference(pref) {
    try {
      localStorage.setItem(STORAGE_KEY, pref)
    }
    catch {}
    hideBanner()
    if (pref === 'accepted') {
      window.__CONSENT_STATUS = 'accepted'
    }
    else if (pref === 'functional') {
      window.__CONSENT_STATUS = 'functional'
    }
    else {
      window.__CONSENT_STATUS = 'rejected'
    }
  }

  function init() {
    var pref
    try {
      pref = localStorage.getItem(STORAGE_KEY)
    }
    catch {
      pref = null
    }

    if (!pref) {
      showBanner()
    }
    else if (pref === 'accepted') {
      window.__CONSENT_STATUS = 'accepted'
    }
    else if (pref === 'functional') {
      window.__CONSENT_STATUS = 'functional'
    }
    else {
      window.__CONSENT_STATUS = 'rejected'
    }

    var rejectBtn = document.getElementById('consent-reject')
    var functionalBtn = document.getElementById('consent-functional')
    var acceptBtn = document.getElementById('consent-accept')

    if (rejectBtn)
      rejectBtn.addEventListener('click', function() { setPreference('rejected') })
    if (functionalBtn)
      functionalBtn.addEventListener('click', function() { setPreference('functional') })
    if (acceptBtn)
      acceptBtn.addEventListener('click', function() { setPreference('accepted') })
  }

  init()
})()
</script>