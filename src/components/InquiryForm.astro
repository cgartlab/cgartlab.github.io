  'en': {
    title: 'Project Inquiry',
    titleNote: 'Fill out the form below and I will get back to you soon.',
    projectType: 'Project Type',
    projectTypeOptions: [
      { value: '', label: 'Select project type' },
      { value: 'motion', label: 'Motion Graphics' },
      { value: 'uiux', label: 'UI/UX Design' },
      { value: 'frontend', label: 'Frontend Development' },
      { value: 'ai', label: 'AI Workflow' },
      { value: 'illustration', label: 'Digital Illustration' },
      { value: 'other', label: 'Other' },
    ],
    budget: 'Budget Range',
    budgetOptions: [
      { value: '', label: 'Select budget range' },
      { value: 'under5k', label: 'Under $700' },
      { value: '5k-15k', label: '$700 - $2,000' },
      { value: '15k-50k', label: '$2,000 - $7,000' },
