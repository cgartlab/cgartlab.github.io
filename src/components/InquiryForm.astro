      { value: 'under5k', label: '5,000 元以下' },
      { value: '5k-15k', label: '5,000 - 15,000 元' },
      { value: '15k-50k', label: '15,000 - 50,000 元' },
      { value: 'above50k', label: '50,000 元以上' },
      { value: 'discuss', label: '暫不明確，想先聊聊' },
    ],
    timeline: '預計時間線',
    timelineOptions: [
      { value: '', label: '請選擇時間線' },
      { value: 'urgent', label: '緊急（1 週內）' },
      { value: '1month', label: '1 - 4 週' },
      { value: '1-3months', label: '1 - 3 個月' },
      { value: 'flexible', label: '時間靈活' },
