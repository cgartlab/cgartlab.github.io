---
import type { ImageMetadata } from 'astro'
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import { getPostPath } from '@/i18n/path'

interface Props {
  posts: Post[]
  lang: Language
}

const { posts, lang } = Astro.props

// Column name placeholder for thumbnails without a cover image
const placeholderText: Record<Language, string> = {
  'zh': '专栏',
  'zh-tw': '專欄',
  'en': 'Column',
}

// Group posts by year
const postsByYear = new Map<number, Post[]>()
for (const post of posts) {
  const year = post.data.published.getFullYear()
  if (!postsByYear.has(year))
postsByYear.set(year, [])
  postsByYear.get(year)!.push(post)
}
const sortedYears = [...postsByYear.keys()].sort((a, b) => b - a)

// Extract issue number from abbrlink (e.g. "weekly-16" → "16")
function getIssueNumber(post: Post): string {
  const abbr = post.data.abbrlink || ''
  const m = abbr.match(/weekly-(\d+)/)
  return m ? m[1] : ''
}

// Dynamic import for thumbnails
const imagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/posts/_images/**/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
)

// Extract first image from post body
async function getThumbnail(post: Post): Promise<{ type: 'image', src: string } | null> {
  const content = post.body || ''
  const imageMatch = content.match(/!\[.*?\]\((.*?\.(?:webp|jpg|jpeg|png|gif))\)/)
  if (imageMatch) {
    const imagePath = imageMatch[1]
    if (imagePath.startsWith('./_images/') || imagePath.startsWith('../_images/')) {
      const decodedPath = decodeURIComponent(imagePath)
      const imageName = decodedPath.replace(/^(\.\.?\/)?_images\//, '')
      const absolutePath = `/src/content/posts/_images/${imageName}`
      const imageImporter = imagesGlob[absolutePath]
      if (imageImporter) {
        const imageMetadata = imageImporter.default
        return { type: 'image', src: imageMetadata.src }
      }
    }
    if (imagePath.startsWith('http')) {
      return { type: 'image', src: imagePath }
    }
    return { type: 'image', src: imagePath }
  }
  return null
}

// Get post description
function getDescription(post: Post): string {
  return post.data.description || ''
}
---

<div class="column-gallery">
  {sortedYears.map((year, yi) => (
    <>
      {yi > 0 && <div class="year-separator" />}
      <div class="column-list">
        {postsByYear.get(year)!.map(async (post) => {
          const slug = post.data.abbrlink || post.id
          const thumbnail = await getThumbnail(post)
          const description = getDescription(post)
          const issueNum = getIssueNumber(post)

          return (
            <div class="column-item">
              <a
                href={getPostPath(slug, lang)}
                class="column-link"
                transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
                data-disable-theme-toggle-transition
              >
                {/* Cover image area */}
                <div class="column-thumbnail">
                  {thumbnail
                    ? (
                      <img
                        src={thumbnail.src}
                        alt={post.data.title}
                        loading="lazy"
                        class="thumbnail-image"
                      />
                    )
                    : (
                      <div class="thumbnail-placeholder">
                        <span class="placeholder-text">{placeholderText[lang]}</span>
                      </div>
                    )}
                </div>

                {/* Content area */}
                <div class="column-info">
                  <h3 class="column-title font-serif">{post.data.title}</h3>
                  {description && <p class="column-description">{description}</p>}
                  <div class="column-meta">
                    <div class="column-date-line">
                      {issueNum && <span class="column-issue-num">#{issueNum}</span>}
                      <span class="column-date">
                        {post.data.published.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'numeric', day: 'numeric' })}
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          )
        })}
      </div>
    </>
  ))}
</div>

<style>
.column-gallery {
  max-width: 1000px;
  margin: 0 auto;
  padding: 1.5rem 0;
}

@media (min-width: 1024px) {
  .column-gallery {
    padding: 2rem 0;
  }
}

/* Grid layout: mobile = 1 col, tablet = 2 cols, desktop = 3-4 cols */
.column-list {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 2rem;
}

.column-item {
  width: 100%;
}

.column-link {
  text-decoration: none;
  color: inherit;
  display: block;
  transition: transform 0.3s ease;
  border: 1px solid color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 15%, transparent);
  border-radius: 8px;
  overflow: hidden;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 50%, transparent);
}

.column-link:hover {
  transform: translateY(-4px);
  border-color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-primary)) 30%, transparent);
}

/* Cover image area */
.column-thumbnail {
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  position: relative;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 30%, transparent);
  border-bottom: 1px solid color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 15%, transparent);
}

.thumbnail-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(100%) contrast(0.55) brightness(1.05) sepia(15%);
  transition: all 0.6s ease;
}

.column-link:hover .thumbnail-image {
  filter: grayscale(0%) contrast(1) brightness(1) sepia(0%);
  transform: scale(1.03);
}

.thumbnail-placeholder {
  width: 100%;
  height: 100%;
  background: color-mix(in srgb, oklch(var(--un-preset-theme-colors-background)) 30%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 60%, transparent);
}

.placeholder-text {
  font-size: 1.25rem;
  font-weight: 600;
  opacity: 0.4;
  letter-spacing: 0.1em;
}

/* Content area */
.column-info {
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.column-title {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.4;
  color: oklch(var(--un-preset-theme-colors-primary));
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.column-description {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.6;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 75%, transparent);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Meta area */
.column-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.8rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 50%, transparent);
  padding-top: 0.75rem;
  border-top: 1px solid color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 15%, transparent);
  margin-top: 0.5rem;
}

.column-date-line {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 60%, transparent);
}

.column-issue-num,
.column-date {
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* Year group separator — matches the top decorative line style */
.year-separator {
  grid-column: 1 / -1;
  height: 1px;
  background: linear-gradient(
    to right,
    transparent,
    color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 25%, transparent) 20%,
    color-mix(in srgb, oklch(var(--un-preset-theme-colors-secondary)) 25%, transparent) 80%,
    transparent
  );
  margin: 2rem 0;
}

/* Responsive grid: 2 columns on tablet and desktop, 1 column on mobile */
@media (min-width: 768px) {
  .column-list {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
}

@media (max-width: 768px) {
  .column-gallery {
    padding: 1.5rem 0;
  }
  .column-thumbnail {
    aspect-ratio: 16 / 9;
  }
  .column-info {
    padding: 1rem 1.25rem;
  }
  .column-title {
    font-size: 1.1rem;
  }
}

@media (max-width: 480px) {
  .column-thumbnail {
    aspect-ratio: 16 / 10;
  }
  .column-title {
    font-size: 1rem;
  }
  .column-description {
    font-size: 0.85rem;
  }
  .placeholder-text {
    font-size: 1rem;
  }
}
</style>
