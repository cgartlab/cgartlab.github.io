<script>
import { ui } from '@/i18n/ui'

interface GithubRepoData {
  owner: { avatar_url: string }
  description: string | null
  stargazers_count: number
  forks_count: number
  license: { spdx_id: string } | null
}

const compactNumberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 })

// 常量
const GITHUB_API_TIMEOUT = 10_000

// 从 document.documentElement.lang 获取当前语言（Astro i18n 设置）
function getCurrentLang(): 'en' | 'zh' | 'zh-tw' {
  const htmlLang = document.documentElement.lang
  if (htmlLang.startsWith('zh-tw') || htmlLang === 'zh-TW') return 'zh-tw'
  if (htmlLang.startsWith('zh')) return 'zh'
  return 'en'
}

// 获取当前语言的 githubCard 翻译
function getGithubCardUI() {
  const lang = getCurrentLang()
  return ui[lang as keyof typeof ui]?.githubCard ?? ui.en.githubCard
}

// 静态数据缓存（构建时生成，避免运行时 API 调用）
let staticData: Record<string, GithubRepoData> | null = null

async function loadStaticData(): Promise<Record<string, GithubRepoData>> {
  if (staticData)
    return staticData
  try {
    const resp = await fetch('/github-repos.json')
    if (resp.ok) {
      staticData = await resp.json()
      return staticData!
    }
  }
  catch {}
  staticData = {}
  return staticData
}

// 静态数据缺失时的回退：客户端 API 调用
async function fetchRepoData(repo: string): Promise<GithubRepoData | null> {
  try {
    const response = await fetch(`https://api.github.com/repos/${repo}`, {
      signal: AbortSignal.timeout(GITHUB_API_TIMEOUT),
    })
    if (!response.ok)
      return null
    const raw = await response.json()
    return {
      owner: { avatar_url: raw.owner?.avatar_url ?? '' },
      description: raw.description,
      stargazers_count: raw.stargazers_count ?? 0,
      forks_count: raw.forks_count ?? 0,
      license: raw.license ? { spdx_id: raw.license.spdx_id } : null,
    }
  }
  catch {
    return null
  }
}

function updateCardUI(card: HTMLElement, data: GithubRepoData | null) {
  const githubCardUI = getGithubCardUI()
  const setText = (selector: string, text: string) => {
    const el = card.querySelector<HTMLElement>(selector)
    if (el)
      el.textContent = text
  }

  if (!data) {
    setText('.gc-repo-description', githubCardUI.failedToLoad)
    return
  }

  const avatar = card.querySelector<HTMLElement>('.gc-owner-avatar')
  if (avatar && data.owner?.avatar_url) {
    avatar.style.backgroundImage = `url(${data.owner.avatar_url})`
  }

  setText('.gc-repo-description', data.description ?? githubCardUI.noDescription)
  setText('.gc-stars-count', compactNumberFormat.format(data.stargazers_count ?? 0))
  setText('.gc-forks-count', compactNumberFormat.format(data.forks_count ?? 0))
  setText('.gc-license-info', data.license?.spdx_id ?? githubCardUI.noLicense)
}

async function loadRepoData(card: HTMLElement) {
  const repo = card.dataset.repo
  if (!repo)
    return

  // 优先使用构建时静态数据（零 API 调用）
  const cached = await loadStaticData()
  if (cached[repo]) {
    updateCardUI(card, cached[repo])
    return
  }

  // 回退：客户端 API 调用
  const data = await fetchRepoData(repo)
  updateCardUI(card, data)
}

function setupGithubCards() {
  const cards = document.querySelectorAll<HTMLElement>('.gc-container')
  if (cards.length === 0)
    return
  cards.forEach(card => loadRepoData(card))
}

document.addEventListener('astro:page-load', setupGithubCards)
document.addEventListener('astro:before-swap', () => {
  document.removeEventListener('astro:page-load', setupGithubCards)
})
</script>
