---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'
import TopIcon from '@/assets/icons/top-icon.svg'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  <div
    id="toc-container"
    class="mb-6 uno-round-border bg-secondary/5 2xl:(fixed bottom-0 left-0 top-44.5 max-w-[min(calc(50vw-38rem),13rem)] border-none bg-secondary/0)"
  >
    <div
      id="toc-header"
      class="h-12 w-full flex cursor-pointer items-center 2xl:(static flex c-secondary/60)"
      role="button"
      tabindex="0"
      aria-expanded="true"
      aria-controls="toc-accordion-content"
    >
      <span id="toc-mobile-text">{currentUI.toc}</span>
      <TocIcon
        id="toc-desktop-icon"
        aria-hidden="true"
        class="ml-4 hidden aspect-square w-4.2 2xl:block"
        fill="currentColor"
      />
    </div>

    <nav
      id="toc-accordion-content"
      aria-label="Table of Contents"
    >
      <ul id="toc-links-list">
        {filteredHeadings.map(heading => (
          <li
            class:list={{
              'ml-0': heading.depth === 2,
              'ml-4': heading.depth === 3,
              'ml-8': heading.depth === 4,
            }}
          >
            <a
              href={`#${heading.slug}`}
              title={heading.text}
              class:list={[
                { 'no-heti toc-links-h2': heading.depth === 2 },
                { 'no-heti toc-links-h3': heading.depth === 3 },
                { 'no-heti toc-links-h4': heading.depth === 4 },
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<!-- Back to Top Button -->
<button
  id="back-to-top"
  class="pointer-events-none fixed bottom-6 right-6 z-50 h-10 w-10 flex items-center justify-center rounded-full opacity-0 transition-all duration-300 active:scale-95 hover:scale-110"
  style="background: oklch(var(--un-preset-theme-colors-background) / 0.8); backdrop-filter: blur(12px); border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.15); box-shadow: 0 4px 16px rgba(0,0,0,0.08);"
  aria-label="Back to top"
  type="button"
>
  <TopIcon aria-hidden="true" class="h-4.5 w-4.5 -translate-y-0.5" fill="currentColor" />
</button>

<style>
  #toc-accordion-content {
    max-height: 1000px;
    opacity: 1;
    overflow: hidden;
    transition: max-height 0.35s ease, opacity 0.25s ease, margin 0.25s ease;
  }
  #toc-container[data-toc-collapsed="true"] #toc-accordion-content {
    max-height: 0;
    opacity: 0;
    margin: 0;
  }
  #toc-desktop-icon {
    transition: transform 0.3s ease;
  }
  #toc-container[data-toc-collapsed="true"] #toc-desktop-icon {
    transform: rotate(-90deg);
  }
</style>

<script>
const is2xl = window.matchMedia('(min-width: 1536px)')

let ticking = false
let lastActiveLink: Element | null = null
let fallbackObserver: IntersectionObserver | null = null
const visibleHeadings = new Set<string>()

function setActiveLink(id: string | null) {
  const tocList = document.getElementById('toc-links-list')
  if (!tocList)
    return

  tocList.querySelectorAll('a.toc-active').forEach(a => a.classList.remove('toc-active'))

  if (!id) {
    lastActiveLink = null
    return
  }

  const link = tocList.querySelector(`a[href="#${CSS.escape(id)}"]`)
  if (link && link !== lastActiveLink) {
    link.classList.add('toc-active')
    if (is2xl.matches) {
      const reducedMotion = document.documentElement.classList.contains('reduce-motion')
        || window.matchMedia('(prefers-reduced-motion: reduce)').matches
      link.scrollIntoView({ behavior: reducedMotion ? 'instant' : 'smooth', block: 'nearest' })
    }
    lastActiveLink = link
  }
}

function scrollToActiveLinkFallback() {
  if (visibleHeadings.size === 0) {
    ticking = false
    return
  }
  const allHeadings = Array.from(document.querySelectorAll('h2[id], h3[id], h4[id]'))
  let firstVisible: string | undefined
  for (const h of allHeadings) {
    if (visibleHeadings.has(h.id)) {
      firstVisible = h.id
      break
    }
  }
  setActiveLink(firstVisible ?? null)
  ticking = false
}

function handleScroll() {
  if (!ticking && is2xl.matches) {
    window.requestAnimationFrame(scrollToActiveLinkFallback)
    ticking = true
  }
}

function setupFallbackObserver() {
  const headings = document.querySelectorAll('h2[id], h3[id], h4[id]')
  if (headings.length === 0)
    return

  fallbackObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        visibleHeadings.add(entry.target.id)
      }
      else {
        visibleHeadings.delete(entry.target.id)
      }
    })

    if (!ticking && is2xl.matches) {
      window.requestAnimationFrame(scrollToActiveLinkFallback)
      ticking = true
    }
  }, {
    rootMargin: '-80px 0px -60% 0px',
    threshold: 0,
  })

  headings.forEach(h => fallbackObserver?.observe(h))
}

function setupAutoScroll() {
  ticking = false
  lastActiveLink = null

  const tocList = document.getElementById('toc-links-list')
  if (!tocList)
    return

  setupFallbackObserver()
  document.addEventListener('scroll', handleScroll, { passive: true })
}

function cleanupAutoScroll() {
  document.removeEventListener('scroll', handleScroll)
  fallbackObserver?.disconnect()
  fallbackObserver = null
  visibleHeadings.clear()
  lastActiveLink = null
}

function setupTocToggle() {
  const tocHeader = document.getElementById('toc-header')
  if (!tocHeader)
    return
  tocHeader.addEventListener('click', () => {
    const container = document.getElementById('toc-container')
    if (!container)
      return
    const isCollapsed = container.getAttribute('data-toc-collapsed') === 'true'
    if (isCollapsed) {
      container.removeAttribute('data-toc-collapsed')
      tocHeader.setAttribute('aria-expanded', 'true')
    }
    else {
      container.setAttribute('data-toc-collapsed', 'true')
      tocHeader.setAttribute('aria-expanded', 'false')
    }
  })
  tocHeader.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      tocHeader.click()
    }
  })
}

function setupBackToTop() {
  const btn = document.getElementById('back-to-top')
  if (!btn)
    return
  const handleScroll = () => {
    if (window.scrollY > 500) {
      btn.classList.remove('opacity-0', 'pointer-events-none')
    }
    else {
      btn.classList.add('opacity-0', 'pointer-events-none')
    }
  }
  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
  window.addEventListener('scroll', handleScroll, { passive: true })
}

function cleanupBackToTop() {
  const btn = document.getElementById('back-to-top')
  if (btn) {
    btn.replaceWith(btn.cloneNode(true))
  }
}

document.addEventListener('astro:page-load', setupAutoScroll)
document.addEventListener('astro:page-load', setupTocToggle)
document.addEventListener('astro:page-load', setupBackToTop)
document.addEventListener('astro:before-swap', cleanupAutoScroll)
document.addEventListener('astro:before-swap', cleanupBackToTop)
</script>
