---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  // TOC Container
  <div
    id="toc-container"
    class="mb-6 uno-round-border bg-secondary/5 2xl:(fixed left-0 top-44.5 bottom-0 max-w-[min(calc(50vw-38rem),13rem)] border-none bg-secondary/0)"
  >
    {/* Hidden Checkbox */}
    <input
      type="checkbox"
      id="toc-toggle"
      hidden
    />
    {/* TOC Toggle */}
    <div class="relative h-12 w-full">
      <label
        for="toc-toggle"
        class="absolute inset-0 flex cursor-pointer items-center 2xl:(static flex c-secondary/60 transition-colors ease-out hover:c-primary)"
      >
        {/* Title on Mobile */}
        <span id="toc-mobile-text">
          {currentUI.toc}
        </span>

        {/* Icon on Desktop */}
        <TocIcon
          id="toc-desktop-icon"
          aria-hidden="true"
          class="ml-4 hidden aspect-square w-4.2 2xl:(mt-4 block origin-center active:scale-90!)"
          fill="currentColor"
        />
      </label>
    </div>

    {/* Expandable Content Wrapper with Accordion Animation */}
    <div id="toc-accordion-wrapper">
      <nav
        id="toc-accordion-content"
        aria-label="Table of Contents"
      >
        {/* TOC List */}
        <ul id="toc-links-list">
          {filteredHeadings.map(heading => (
            <li
              class:list={{
                'ml-0': heading.depth === 2,
                'ml-4': heading.depth === 3,
                'ml-8': heading.depth === 4,
              }}
            >
              <a
                href={`#${heading.slug}`}
                class:list={[
                  { 'no-heti toc-links-h2': heading.depth === 2 },
                  { 'no-heti toc-links-h3': heading.depth === 3 },
                  { 'no-heti toc-links-h4': heading.depth === 4 },
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
)}

<script>
const is2xl = window.matchMedia('(min-width: 1536px)')

let ticking = false
let lastActiveLink: Element | null = null
let fallbackObserver: IntersectionObserver | null = null
const visibleHeadings = new Set<string>()

function setActiveLink(id: string | null) {
  const tocList = document.getElementById('toc-links-list')
  if (!tocList) return

  // 移除旧高亮
  tocList.querySelectorAll('a.toc-active').forEach(a => a.classList.remove('toc-active'))

  if (!id) {
    lastActiveLink = null
    return
  }

  const link = tocList.querySelector(`a[href="#${CSS.escape(id)}"]`)
  if (link && link !== lastActiveLink) {
    link.classList.add('toc-active')
    if (is2xl.matches) {
      // reduce-motion 模式下使用 instant，避免不必要的滚动动画
      const reducedMotion = document.documentElement.classList.contains('reduce-motion')
        || window.matchMedia('(prefers-reduced-motion: reduce)').matches
      link.scrollIntoView({ behavior: reducedMotion ? 'instant' : 'smooth', block: 'nearest' })
    }
    lastActiveLink = link
  }
}

function scrollToActiveLinkFallback() {
  if (visibleHeadings.size === 0) {
    ticking = false
    return
  }
  // 按 DOM 顺序找最靠前的可见标题（比字典序更可靠）
  const allHeadings = Array.from(document.querySelectorAll('h2[id], h3[id], h4[id]'))
  let firstVisible: string | undefined
  for (const h of allHeadings) {
    if (visibleHeadings.has(h.id)) {
      firstVisible = h.id
      break
    }
  }
  setActiveLink(firstVisible ?? null)
  ticking = false
}

function handleScroll() {
  if (!ticking && is2xl.matches) {
    window.requestAnimationFrame(scrollToActiveLinkFallback)
    ticking = true
  }
}

function setupFallbackObserver() {
  const headings = document.querySelectorAll('h2[id], h3[id], h4[id]')
  if (headings.length === 0) return

  fallbackObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        visibleHeadings.add(entry.target.id)
      }
      else {
        visibleHeadings.delete(entry.target.id)
      }
    })

    if (!ticking && is2xl.matches) {
      window.requestAnimationFrame(scrollToActiveLinkFallback)
      ticking = true
    }
  }, {
    rootMargin: '-80px 0px -60% 0px',
    threshold: 0,
  })

  headings.forEach((h) => fallbackObserver?.observe(h))
}

function setupAutoScroll() {
  ticking = false
  lastActiveLink = null

  const tocList = document.getElementById('toc-links-list')
  if (!tocList) return

  // 统一使用 IntersectionObserver 方案（scroll-target-group 已移除）
  setupFallbackObserver()
  document.addEventListener('scroll', handleScroll, { passive: true })
}

function cleanupAutoScroll() {
  document.removeEventListener('scroll', handleScroll)
  fallbackObserver?.disconnect()
  fallbackObserver = null
  visibleHeadings.clear()
  lastActiveLink = null
}

document.addEventListener('astro:page-load', setupAutoScroll)
document.addEventListener('astro:before-swap', cleanupAutoScroll)
</script>
