---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  <div
    id="toc-container"
    class="mb-6 uno-round-border bg-secondary/5 2xl:(fixed left-0 top-44.5 bottom-0 max-w-[calc(50vw-38rem)] border-none bg-secondary/0)"
  >
    <div class="flex h-12 w-full items-center 2xl:(static flex c-secondary/60)">
      <span id="toc-mobile-text">
        {currentUI.toc}
      </span>
      <TocIcon
        id="toc-desktop-icon"
        aria-hidden="true"
        class="ml-4 hidden aspect-square w-4.2 2xl:block"
        fill="currentColor"
      />
    </div>

    <nav
      id="toc-accordion-content"
      aria-label="Table of Contents"
    >
      <ul id="toc-links-list">
        {filteredHeadings.map(heading => (
          <li
            class:list={{
              'ml-0': heading.depth === 2,
              'ml-4': heading.depth === 3,
              'ml-8': heading.depth === 4,
            }}
          >
            <a
              href={`#${heading.slug}`}
              title={heading.text}
              class:list={[
                { 'no-heti toc-links-h2': heading.depth === 2 },
                { 'no-heti toc-links-h3': heading.depth === 3 },
                { 'no-heti toc-links-h4': heading.depth === 4 },
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<script>
const is2xl = window.matchMedia('(min-width: 1536px)')

let ticking = false
let lastActiveLink: Element | null = null
let fallbackObserver: IntersectionObserver | null = null
const visibleHeadings = new Set<string>()

function setActiveLink(id: string | null) {
  const tocList = document.getElementById('toc-links-list')
  if (!tocList) return

  tocList.querySelectorAll('a.toc-active').forEach(a => a.classList.remove('toc-active'))

  if (!id) {
    lastActiveLink = null
    return
  }

  const link = tocList.querySelector(`a[href="#${CSS.escape(id)}"]`)
   if (link && link !== lastActiveLink) {
    link.classList.add('toc-active')
     const reducedMotion = document.documentElement.classList.contains('reduce-motion')
       || window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (is2xl.matches) {
      link.scrollIntoView({ behavior: reducedMotion ? 'instant' : 'smooth', block: 'nearest' })
    }
    lastActiveLink = link
  }
}

function scrollToActiveLinkFallback() {
  if (visibleHeadings.size === 0) {
    ticking = false
    return
  }
  const allHeadings = Array.from(document.querySelectorAll('h2[id], h3[id], h4[id]'))
  let firstVisible: string | undefined
  for (const h of allHeadings) {
    if (visibleHeadings.has(h.id)) {
      firstVisible = h.id
      break
    }
  }
  setActiveLink(firstVisible ?? null)
  ticking = false
}

function handleScroll() {
  if (!ticking) {
    window.requestAnimationFrame(scrollToActiveLinkFallback)
    ticking = true
  }
}

function setupFallbackObserver() {
  const headings = document.querySelectorAll('h2[id], h3[id], h4[id]')
  if (headings.length === 0) return

  fallbackObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        visibleHeadings.add(entry.target.id)
      }
      else {
        visibleHeadings.delete(entry.target.id)
      }
      })

    if (!ticking) {
      window.requestAnimationFrame(scrollToActiveLinkFallback)
      ticking = true
    }
  }, {
    rootMargin: '-80px 0px -60% 0px',
    threshold: 0,
  })

  headings.forEach((h) => fallbackObserver?.observe(h))
}

function setupAutoScroll() {
  ticking = false
  lastActiveLink = null

  const tocList = document.getElementById('toc-links-list')
  if (!tocList) return

  setupFallbackObserver()
  document.addEventListener('scroll', handleScroll, { passive: true })
}

function cleanupAutoScroll() {
  document.removeEventListener('scroll', handleScroll)
  fallbackObserver?.disconnect()
  fallbackObserver = null
  visibleHeadings.clear()
lastActiveLink = null
}

function setupTOCAccordion() {
  const tocContainer = document.getElementById('toc-container')
  const tocHeader = tocContainer?.querySelector('div:first-child')
  const tocContent = document.getElementById('toc-accordion-content')
  if (!tocContainer || !tocHeader || !tocContent) return

  tocContainer.classList.remove('toc-hidden')
  tocContent.style.display = ''
  tocContent.style.transform = ''
  tocContent.style.opacity = ''
  tocContent.style.transition = ''
  tocHeader.addEventListener('click', toggleTOC)
}

function cleanupTOCAccordion() {
  const tocHeader = document.querySelector('#toc-container > div:first-child')
  if (tocHeader) {
    tocHeader.removeEventListener('click', toggleTOC)
  }
  const container = document.getElementById('toc-container')
  const content = document.getElementById('toc-accordion-content')
  if (content) {
    content.style.display = ''
    content.style.transform = ''
    content.style.transformOrigin = ''
    content.style.opacity = ''
    content.style.transition = ''
  }
  if (container) {
    container.classList.remove('toc-hidden')
  }
}

function toggleTOC() {
  const container = document.getElementById('toc-container')
  const content = document.getElementById('toc-accordion-content')
  if (!container || !content) return

  const isCollapsed = container.classList.contains('toc-hidden')

  if (isCollapsed) {
    container.classList.remove('toc-hidden')
    content.style.display = ''
    content.style.transformOrigin = 'top center'
    content.style.transform = 'scaleY(0)'
    content.style.opacity = '0'
    void content.offsetHeight
    content.style.transition = 'transform 0.25s ease-out, opacity 0.2s ease-out'
    content.style.transform = 'scaleY(1)'
    content.style.opacity = '1'
    content.addEventListener('transitionend', function onExpandEnd() {
      content.style.transition = ''
      content.style.transform = ''
      content.style.transformOrigin = ''
      content.style.opacity = ''
      content.removeEventListener('transitionend', onExpandEnd)
    })
  } else {
    content.style.transition = 'transform 0.2s ease-in, opacity 0.15s ease-in'
    content.style.transformOrigin = 'top center'
    content.style.transform = 'scaleY(0)'
    content.style.opacity = '0'
    content.addEventListener('transitionend', function onCollapseEnd() {
      container.classList.add('toc-hidden')
      content.style.display = 'none'
      content.style.transition = ''
      content.style.transform = ''
      content.style.transformOrigin = ''
      content.style.opacity = ''
      content.removeEventListener('transitionend', onCollapseEnd)
    })
  }
}

document.addEventListener('astro:page-load', setupAutoScroll)
document.addEventListener('astro:page-load', setupTOCAccordion)
document.addEventListener('astro:before-swap', cleanupAutoScroll)
document.addEventListener('astro:before-swap', cleanupTOCAccordion)

</script>
