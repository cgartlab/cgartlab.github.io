---
import 'lite-youtube-embed/src/lite-yt-embed.css'
---

<script>
// Initialize Mermaid diagrams
async function setupMermaidEmbeds() {
  const mermaids = document.querySelectorAll('pre.mermaid')
  if (mermaids.length === 0) {
    return
  }

  // Store original code for re-rendering
  mermaids.forEach((element) => {
    const mermaid = element as HTMLElement
    if (!mermaid.dataset.mermaidCode) {
      mermaid.dataset.mermaidCode = mermaid.textContent?.trim() ?? ''
    }
  })

  // Load and run Mermaid
  try {
    const { default: mermaid } = await import('mermaid')
    mermaid.initialize({
      startOnLoad: false,
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
    })
    mermaid.run()
  }
  catch (error) {
    console.error('[MediaEmbed] Failed to load Mermaid:', error)
  }
}

// Load YouTube embed script
async function setupYouTubeEmbeds() {
  const youtube = document.querySelectorAll('lite-youtube')
  if (youtube.length === 0) {
    return
  }

  try {
    // @ts-expect-error - No type definitions available for lite-youtube-embed
    await import('lite-youtube-embed')
  }
  catch (error) {
    console.error('[MediaEmbed] Failed to load YouTube embed:', error)
  }
}

// Initialize Twitter widgets
async function setupTweetEmbeds() {
  const tweets = document.querySelectorAll('.twitter-tweet')
  if (tweets.length === 0) {
    return
  }

  tweets.forEach((tweet) => {
    tweet.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')
  })

  // Inject Twitter script
  const script = document.createElement('script')
  script.src = 'https://platform.twitter.com/widgets.js'
  script.async = true
  document.head.appendChild(script)
}

// Initialize all media embeds
async function setupMediaEmbeds() {
  await Promise.allSettled([
    setupYouTubeEmbeds(),
    setupTweetEmbeds(),
    setupMermaidEmbeds(),
    setupVideoEmbeds(),
  ])
}

// Setup video autoplay and visibility-based pausing
// Module-level observer reference so cleanup can disconnect it
let videoObserver: IntersectionObserver | null = null

async function setupVideoEmbeds() {
  const videos = document.querySelectorAll('.heti video')
  if (videos.length === 0) {
    return
  }

  // Disconnect previous observer before creating a new one
  if (videoObserver) {
    videoObserver.disconnect()
    videoObserver = null
  }

  // Ensure muted + playsinline, load source, and play once ready
  videos.forEach((video) => {
    const vid = video as HTMLVideoElement
    vid.muted = true
    if (!vid.hasAttribute('playsinline')) {
      vid.setAttribute('playsinline', '')
    }
    if (!vid.preload || vid.preload === 'none') {
      vid.preload = 'auto'
    }
    // Kick off loading so the video actually fetches its source
    vid.load()
    // Wait until enough data is buffered, then play
    function tryPlay() {
      vid.play().catch((e) => {
        console.warn('[Video] autoplay attempt 1 failed:', e)
        // Some browsers may need a second attempt after metadata
        vid.addEventListener('canplay', () => {
          vid.play().catch(e2 => console.warn('[Video] autoplay attempt 2 failed:', e2))
        }, { once: true })
      })
    }
    if (vid.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
      tryPlay()
    }
    else {
      vid.addEventListener('loadedmetadata', tryPlay, { once: true })
    }
  })

  // Pause videos when they scroll out of viewport
  if ('IntersectionObserver' in window) {
    videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement
          if (entry.isIntersecting) {
            video.play().catch(e => console.warn('[Video] autoplay on scroll-in failed:', e))
          }
          else {
            video.pause()
          }
        })
      },
      { threshold: 0.3 },
    )

    videos.forEach(video => videoObserver!.observe(video))
  }
}

// Re-render Mermaid diagrams on theme change
function updateMermaidTheme() {
  const mermaids = document.querySelectorAll('pre.mermaid[data-mermaid-code]')
  if (mermaids.length === 0) {
    return
  }

  const isDark = document.documentElement.classList.contains('dark')

  import('mermaid').then(({ default: mermaid }) => {
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
    })

    // Reset content and re-run Mermaid
    mermaids.forEach((element) => {
      const mermaid = element as HTMLElement
      mermaid.innerHTML = mermaid.dataset.mermaidCode ?? ''
      mermaid.removeAttribute('data-processed')
    })

    mermaid.run()
  }).catch((error) => {
    console.error('[MediaEmbed] Failed to update Mermaid theme:', error)
  })
}

// Handle horizontal scrolling for gallery
function handleGalleryWheel(e: WheelEvent) {
  const container = (e.target as Element)?.closest('.gallery-container') as HTMLElement
  if (!container) {
    return
  }

  // Convert vertical scroll to horizontal
  const previousScrollLeft = container.scrollLeft
  container.scrollLeft += e.deltaY
  if (container.scrollLeft === previousScrollLeft) {
    return
  }

  // Prevent default scroll only if horizontal scroll occurred
  e.preventDefault()
}

function setupMediaEmbedsAndListeners() {
  setupMediaEmbeds()
  document.addEventListener('wheel', handleGalleryWheel, { passive: false })
}

function cleanupMediaEmbedsAndListeners() {
  if (videoObserver) {
    videoObserver.disconnect()
    videoObserver = null
  }
  document.removeEventListener('wheel', handleGalleryWheel)
}

document.addEventListener('astro:page-load', setupMediaEmbedsAndListeners)
document.addEventListener('astro:before-swap', cleanupMediaEmbedsAndListeners)
document.addEventListener('theme-changed', updateMermaidTheme)
</script>
