<script>
let overlay: HTMLDivElement | null = null
let zoomedImg: HTMLImageElement | null = null
let originalImg: HTMLImageElement | null = null
let transitionFallbackTimer: number | null = null

// 常量
const ZOOM_TRANSITION_DURATION = 350
const MOBILE_BREAKPOINT = 768
const SCALE_FACTOR_MOBILE = 1
const SCALE_FACTOR_DESKTOP = 0.8

// Setup overlay element
function setupOverlay() {
  overlay = document.createElement('div')
  overlay.className = 'zoom-overlay'
  overlay.setAttribute('role', 'dialog')
  overlay.setAttribute('aria-modal', 'true')
  overlay.setAttribute('aria-label', 'Image Viewer')
  overlay.setAttribute('tabindex', '-1')

  document.body.appendChild(overlay)
}

// Lock body scroll (iOS-compatible)
let savedScrollY = 0
function lockBodyScroll() {
  savedScrollY = window.scrollY
  document.body.style.top = `-${savedScrollY}px`
  document.body.classList.add('scroll-lock')
}

// Unlock body scroll and restore position
function unlockBodyScroll() {
  document.body.classList.remove('scroll-lock')
  document.body.style.top = ''
  window.scrollTo(0, savedScrollY)
}

// 统一清理：overlay、zoomedImg、timer、scroll-lock、引用
function cleanupZoom() {
  if (transitionFallbackTimer !== null) {
    clearTimeout(transitionFallbackTimer)
    transitionFallbackTimer = null
  }
  // 物理移除 DOM 节点（不等 transition 完成，避免导航中节点残留）
  zoomedImg?.remove()
  overlay?.remove()
  // 确保导航时 scroll-lock 被移除，防止下一页无法滚动
  if (document.body.classList.contains('scroll-lock')) {
    unlockBodyScroll()
  }
  overlay = null
  zoomedImg = null
  originalImg = null
}

// Zoom in the image
function zoomIn(img: HTMLImageElement) {
  if (!overlay) {
    return
  }

  // Disable scrolling and get position
  lockBodyScroll()
  const rect = img.getBoundingClientRect()
  originalImg = img

  // Clone and setup image
  zoomedImg = img.cloneNode() as HTMLImageElement
  zoomedImg.className = 'zoom-img'
  zoomedImg.removeAttribute('id')
  zoomedImg.removeAttribute('loading')

  zoomedImg.style.top = `${rect.top}px`
  zoomedImg.style.left = `${rect.left}px`
  zoomedImg.style.width = `${rect.width}px`
  zoomedImg.style.height = `${rect.height}px`

  // Add to DOM and show
  document.body.appendChild(zoomedImg)
  overlay.style.display = 'block'
  overlay.focus()

  // Calculate scale and position
  const viewportWidth = window.innerWidth
  const viewportHeight = window.innerHeight
  const scaleFactor = viewportWidth < MOBILE_BREAKPOINT ? SCALE_FACTOR_MOBILE : SCALE_FACTOR_DESKTOP
  const scale = Math.min(
    (viewportWidth * scaleFactor) / rect.width,
    (viewportHeight * scaleFactor) / rect.height,
  )
  const translateX = (-rect.left + (viewportWidth - rect.width) / 2) / scale
  const translateY = (-rect.top + (viewportHeight - rect.height) / 2) / scale

  // Start animation
  requestAnimationFrame(() => {
    if (overlay) {
      overlay.style.opacity = '1'
    }

    if (zoomedImg) {
      zoomedImg.style.transform = `scale(${scale}) translate3d(${translateX}px, ${translateY}px, 0)`
    }
  })
}

// Zoom out the image
function zoomOut() {
  if (!overlay || !zoomedImg || !originalImg) {
    return
  }

  // Start closing animation
  zoomedImg.style.transform = ''
  overlay.style.opacity = '0'
  unlockBodyScroll()

  // Define cleanup logic
  const cleanup = () => {
    if (!zoomedImg) {
      return
    }

    // Remove zoomed image
    zoomedImg?.remove()
    zoomedImg = null

    // Hide overlay
    if (overlay) {
      overlay.style.display = 'none'
    }

    // Restore focus
    originalImg?.focus()
    originalImg = null
  }

  // Fallback: clear any pending fallback timeout from a previous zoomOut
  if (transitionFallbackTimer !== null) {
    clearTimeout(transitionFallbackTimer)
  }

  // Capture current ref so both paths operate on the same element
  const imgToClean = zoomedImg

  // Listen for transition end to cleanup (with 350ms fallback)
  const onEnd = () => {
    if (transitionFallbackTimer !== null) {
      clearTimeout(transitionFallbackTimer)
      transitionFallbackTimer = null
    }
    cleanup()
  }
  imgToClean.addEventListener('transitionend', onEnd, { once: true })

  transitionFallbackTimer = window.setTimeout(() => {
    transitionFallbackTimer = null
    // Remove the transitionend listener so it can't fire after cleanup
    imgToClean.removeEventListener('transitionend', onEnd)
    cleanup()
  }, ZOOM_TRANSITION_DURATION)
}

// Handle click events
function handleClick(event: MouseEvent) {
  if (zoomedImg) {
    zoomOut()
    return
  }

  const target = event.target
  if (!(target instanceof HTMLImageElement)) {
    return
  }

  // Ignore small or incomplete images
  if (!target.complete || target.width < 100 || target.height < 100) {
    return
  }

  event.preventDefault()
  zoomIn(target)
}

document.addEventListener('astro:page-load', setupOverlay)
document.addEventListener('astro:before-swap', () => {
  cleanupZoom()
  document.removeEventListener('click', handleClick)
  window.removeEventListener('resize', zoomOut)
})
document.addEventListener('astro:page-load', () => {
  document.addEventListener('click', handleClick)
  window.addEventListener('resize', zoomOut)
})
</script>
