---
// GitHub Contribution Heatmap Component
// Fetches data at build time from github-contributions-api
// Displays a contribution grid similar to GitHub's profile heatmap

import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? ui.zh

interface ContributionCell {
  color: string
  contributionCount: number
  contributionLevel: 'NONE' | 'FIRST_QUARTILE' | 'SECOND_QUARTILE' | 'THIRD_QUARTILE' | 'FOURTH_QUARTILE'
  date: string
}

interface ContributionData {
  contributions: ContributionCell[][]
  total: number
}

const API_URL = 'https://github-contributions-api.deno.dev/cgartlab.json'

let data: ContributionData = { contributions: [], total: 0 }
let fetchError = false

try {
  const response = await fetch(API_URL)
  if (response.ok) {
    const json = await response.json()
    data = {
      contributions: json.contributions as ContributionCell[][],
      total: json.totalContributions as number,
    }
  }
  else {
    fetchError = true
  }
}
catch (e) {
  console.error('[GithubHeatmap] Failed to fetch data:', e)
  fetchError = true
}

// Date formatters (must be before getMonthLabels which uses them)
const monthFormatter = new Intl.DateTimeFormat(currentLang, { month: 'short' })
const dayFormatter = new Intl.DateTimeFormat(currentLang, { weekday: 'short' })

// Determine month labels based on actual dates in contributions
function getMonthLabels(contributions: ContributionCell[][]): { month: string, weekIndex: number }[] {
  const labels: { month: string, weekIndex: number }[] = []
  let lastMonth = -1

  contributions.forEach((week, weekIndex) => {
    const dayWithDate = week.find(day => day.date)
    if (!dayWithDate)
return

    const date = new Date(`${dayWithDate.date}T00:00:00`)
    const month = date.getMonth()

    if (month !== lastMonth) {
      labels.push({ month: monthFormatter.format(new Date(2024, month, 1)), weekIndex })
      lastMonth = month
    }
  })

  return labels
}

const contributions = data.contributions
const monthLabels = contributions.length > 0 ? getMonthLabels(contributions) : []
const totalFormatted = data.total.toLocaleString()


// SSR-friendly date format function
function formatDateStr(dateStr: string): string {
  const date = new Date(`${dateStr}T00:00:00`)
  return date.toLocaleDateString(currentLang, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
}

const levelClassMap: Record<string, string> = {
  NONE: 'gh-cell--none',
  FIRST_QUARTILE: 'gh-cell--first-quartile',
  SECOND_QUARTILE: 'gh-cell--second-quartile',
  THIRD_QUARTILE: 'gh-cell--third-quartile',
  FOURTH_QUARTILE: 'gh-cell--fourth-quartile',
}

const dayIndices = [0, 1, 2, 3, 4, 5, 6]
const dayLabelMap: Record<number, string> = {
  0: dayFormatter.format(new Date(2024, 0, 7)),
  6: dayFormatter.format(new Date(2024, 0, 6)),
}

// Cell pitch: 10px cell + 2px gap = 12px per column
const CELL_PITCH = 12
---

{
  fetchError || contributions.length === 0
? (
    <div class={`gh-heatmap gh-heatmap--error ${className}`}>
      <div class="gh-header">
        <h2 class="gh-title font-serif">{currentUI.contributionTitle || 'GitHub Contributions'}</h2>
      </div>
      <p class="gh-error-msg">{currentUI.contributionUnavailable || 'Contribution data unavailable'}</p>
    </div>
  )
: (
    <div class={`gh-heatmap ${className}`}>
      <div class="gh-header">
        <h2 class="gh-title font-serif">{currentUI.contributionTitle || 'GitHub Contributions'}</h2>
        <div class="gh-legend">
          <span class="gh-legend-label">{currentUI.contributionLess || 'Less'}</span>
          <span class="gh-cell gh-cell--none" aria-hidden="true"></span>
          <span class="gh-cell gh-cell--first-quartile" aria-hidden="true"></span>
          <span class="gh-cell gh-cell--second-quartile" aria-hidden="true"></span>
          <span class="gh-cell gh-cell--third-quartile" aria-hidden="true"></span>
          <span class="gh-cell gh-cell--fourth-quartile" aria-hidden="true"></span>
          <span class="gh-legend-label">{currentUI.contributionMore || 'More'}</span>
        </div>
      </div>

      <div class="gh-grid-scale-container" id="heatmap-scale-container">
        <div class="gh-grid-wrapper" id="heatmap-wrapper">
          <div class="gh-grid" role="grid" aria-label="GitHub contribution activity">
          <!-- Month labels row -->
          <div class="gh-months" aria-hidden="true">
            <div class="gh-day-labels-placeholder"></div>
            {monthLabels.map(({ month, weekIndex }) => {
              const offset = weekIndex * CELL_PITCH
              return <div class="gh-month-label" style={`left: ${offset}px`}>{month}</div>
            })}
          </div>

          <!-- Grid rows with day labels -->
          <div class="gh-rows">
            {dayIndices.map((dayIndex) => {
              const dayLabel = dayLabelMap[dayIndex] ?? ''
              return (
                <div class="gh-row" role="row">
                  <div class="gh-day-label" aria-hidden="true">{dayLabel}</div>
                  <div class="gh-cells">
                    {contributions.map((week, weekIndex) => {
                      const cell = week[dayIndex]
                      if (!cell) {
                        return <span class="gh-cell gh-cell--none" aria-hidden="true"></span>
                      }
                      const levelClass = levelClassMap[cell.contributionLevel] ?? 'gh-cell--none'
                      const tooltipId = `gh-tooltip-${cell.date}`
                      const isFirstCell = weekIndex === 0 && dayIndex === 0
                      return (
                        <span
                          class={`gh-cell ${levelClass}`}
                          data-date={cell.date}
                          data-count={cell.contributionCount}
                          tabindex={isFirstCell ? '0' : '-1'}
                          role="gridcell"
                          aria-describedby={tooltipId}
                        >
                          <span class="gh-tooltip" role="tooltip" id={tooltipId}>
                            {formatDateStr(cell.date)} 提交 {cell.contributionCount} 次
                          </span>
                        </span>
                      )
                    })}
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
      </div>

      <div class="gh-footer">
        <span class="gh-total">
          {(currentUI.contributionYear || '{n} contributions in the past year').replace('{n}', totalFormatted)}
        </span>
      </div>
    </div>
  )
}

<script is:inline>
/**
 * Heatmap Proportional Scaling (Scale-to-Fit)
 *
 * Replaces horizontal scroll with CSS transform: scale(), so the entire
 * heatmap is always visible at any viewport width without scrolling.
 *
 * - Scale factor = containerWidth / naturalWidth (no cap — grid always fills
 *   container; on desktop this enlarges ~1.06×, on mobile it shrinks to fit)
 * - transform-origin: top left — grid scales from the top-left corner
 * - Container height is synced to preserve document flow (no CLS)
 * - Uses ResizeObserver for accurate, debounced recalculation
 * - Compatible with Astro View Transitions (astro:page-load cleanup)
 */
(function () {
  var SCALE_CONTAINER_ID = 'heatmap-scale-container'
  var WRAPPER_ID = 'heatmap-wrapper'

  function initHeatmapScale() {
    var container = document.getElementById(SCALE_CONTAINER_ID)
    var wrapper = document.getElementById(WRAPPER_ID)
    if (!container || !wrapper) return

    function updateScale() {
      // Temporarily reset transform to measure natural (unscaled) dimensions
      wrapper.style.transform = 'scale(1)'
      // Use offsetWidth (CSS layout box) — NOT scrollWidth, which can be
      // inflated by absolutely-positioned month labels that overflow beyond
      // the grid's actual max-content width (~678px vs true 664px).
      // IMPORTANT: Do NOT add padding or border to .gh-grid-wrapper —
      // offsetWidth includes both, which would overcount and underscale.
      var naturalWidth = wrapper.offsetWidth
      var naturalHeight = wrapper.scrollHeight

      var containerWidth = container.clientWidth
      if (containerWidth === 0) return

      var scale = containerWidth / naturalWidth

      wrapper.style.transform = 'scale(' + scale + ')'
      // Sync container height so subsequent content is not displaced
      container.style.height = (naturalHeight * scale) + 'px'

      // One-shot diagnostic: verify offsetWidth matches the true layout width.
      // scale < 1 means grid shrinks to fit (mobile). scale > 1 means grid
      // expands to fill container (desktop, up to ~1.06×). scrollWidth vs
      // offsetWidth shows the month-label-inflation gap if any.
      if (!container.dataset.scaleDiagnosed) {
        console.log('[Heatmap Scale] offsetWidth:', naturalWidth,
          '| scrollWidth:', wrapper.scrollWidth,
          '| container:', containerWidth,
          '| scale:', scale.toFixed(4),
          '| cell size:', (10 * scale).toFixed(1) + 'px',
          '| gap:', scale > 0 ? (2 * scale).toFixed(1) + 'px' : '0px')
        container.dataset.scaleDiagnosed = 'true'
      }
    }

    updateScale()

    // Use ResizeObserver for accurate, throttled recalculation
    if (typeof ResizeObserver !== 'undefined') {
      var ro = new ResizeObserver(function () {
        requestAnimationFrame(updateScale)
      })
      ro.observe(container)
    } else {
      // Fallback for older browsers
      var timer
      window.addEventListener('resize', function () {
        clearTimeout(timer)
        timer = setTimeout(updateScale, 100)
      })
    }

    // ResizeObserver does NOT fire on device orientation change (iPad rotate,
    // phone rotate) — supplement with orientationchange for full coverage.
    window.addEventListener('orientationchange', function () {
      updateScale()
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeatmapScale)
  } else {
    initHeatmapScale()
  }
})()
</script>

<script>
let heatmapKeydownHandler: ((e: KeyboardEvent) => void) | null = null
let heatmapClickHandler: ((e: MouseEvent) => void) | null = null

function setupHeatmapInteractions() {
  const cells = document.querySelectorAll<HTMLElement>('.gh-cell[data-date]')
  if (cells.length === 0)
    return

  const cellArray = Array.from(cells)
  let columns = 0

  // Determine grid dimensions
  cellArray.forEach((cell) => {
    const row = cell.closest('.gh-row')
    if (row) {
      const cellsInRow = row.querySelectorAll<HTMLElement>('.gh-cell[data-date]')
      columns = cellsInRow.length
    }
  })

  // Re-determine rows/cols properly
  const rows = document.querySelectorAll<HTMLElement>('.gh-row')
  const rowCount = rows.length
  const colCount = columns

  rows.forEach((row, rowIdx) => {
    const rowCells = row.querySelectorAll<HTMLElement>('.gh-cell[data-date]')
    rowCells.forEach((cell, colIdx) => {
      cell.dataset.row = String(rowIdx)
      cell.dataset.col = String(colIdx)
    })
  })

  // Tooltip show/hide
  cells.forEach((cell) => {
    const tooltip = cell.querySelector<HTMLElement>('.gh-tooltip')
    if (!tooltip)
      return

    const showTooltip = () => tooltip.classList.add('gh-tooltip--visible')
    const hideTooltip = () => tooltip.classList.remove('gh-tooltip--visible')

    cell.addEventListener('mouseenter', showTooltip)
    cell.addEventListener('mouseleave', hideTooltip)
    cell.addEventListener('focus', showTooltip)
    cell.addEventListener('blur', hideTooltip)
    // Touch: toggle tooltip on tap
    cell.addEventListener('click', (e) => {
      e.stopPropagation()
      // Close any other open tooltip
      document.querySelectorAll('.gh-tooltip--visible').forEach((t) => {
        if (t !== tooltip)
          t.classList.remove('gh-tooltip--visible')
      })
      tooltip.classList.toggle('gh-tooltip--visible')
    })
  })

  // Keyboard navigation
  const getCell = (row: number, col: number): HTMLElement | null => {
    return document.querySelector<HTMLElement>(
      `.gh-cell[data-row="${row}"][data-col="${col}"]`,
    )
  }

  const focusCell = (row: number, col: number) => {
    const cell = getCell(row, col)
    if (cell) {
      const prev = document.querySelector<HTMLElement>('.gh-cell[tabindex="0"]')
      if (prev && prev !== cell)
        prev.tabIndex = -1
      cell.tabIndex = 0
      cell.focus()
    }
  }

  heatmapKeydownHandler = (e: KeyboardEvent) => {
    const active = document.activeElement
    if (!active || !active.classList.contains('gh-cell'))
      return

    const row = Number.parseInt((active as HTMLElement).dataset.row ?? '0', 10)
    const col = Number.parseInt((active as HTMLElement).dataset.col ?? '0', 10)

    switch (e.key) {
      case 'ArrowUp':
        e.preventDefault()
        focusCell(Math.max(0, row - 1), col)
        break
      case 'ArrowDown':
        e.preventDefault()
        focusCell(Math.min(rowCount - 1, row + 1), col)
        break
      case 'ArrowLeft':
        e.preventDefault()
        focusCell(row, Math.max(0, col - 1))
        break
      case 'ArrowRight':
        e.preventDefault()
        focusCell(row, Math.min(colCount - 1, col + 1))
        break
      case 'Home':
        e.preventDefault()
        if (e.ctrlKey || e.metaKey) {
          focusCell(0, 0)
        }
        else {
          focusCell(row, 0)
        }
        break
      case 'End':
        e.preventDefault()
        if (e.ctrlKey || e.metaKey) {
          focusCell(rowCount - 1, colCount - 1)
        }
        else {
          focusCell(row, colCount - 1)
        }
        break
    }
  }

  // Dismiss when tapping outside
  heatmapClickHandler = (e: MouseEvent) => {
    const target = e.target as HTMLElement
    if (!target.closest('.gh-cell[data-date]')) {
      document.querySelectorAll('.gh-tooltip--visible')
        .forEach(t => t.classList.remove('gh-tooltip--visible'))
    }
  }

  document.addEventListener('keydown', heatmapKeydownHandler)
  document.addEventListener('click', heatmapClickHandler)
}

function cleanupHeatmapInteractions() {
  if (heatmapKeydownHandler) {
    document.removeEventListener('keydown', heatmapKeydownHandler)
    heatmapKeydownHandler = null
  }
  if (heatmapClickHandler) {
    document.removeEventListener('click', heatmapClickHandler)
    heatmapClickHandler = null
  }
}

document.addEventListener('astro:page-load', setupHeatmapInteractions)
document.addEventListener('astro:before-swap', cleanupHeatmapInteractions)
</script>

<style is:global>
/* ==============================
   GitHub Heatmap Styles (Simplified)
   ============================== */

/* Base */
.gh-heatmap {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  width: 100%;
}

.gh-heatmap--error {
  padding: 1rem 0;
}

.gh-error-msg {
  font-size: 0.8125rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.65;
  margin-top: 0.5rem;
}

/* Header */
.gh-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.gh-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: oklch(var(--un-preset-theme-colors-primary));
  margin: 0;
  line-height: 1.3;
}

.gh-legend {
  display: flex;
  align-items: center;
  gap: 3px;
}

.gh-legend-label {
  font-size: 0.6875rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.7;
  padding-inline: 2px;
}

/* Scale container — provides layout space and prevents FOUC */
.gh-grid-scale-container {
  width: 100%;
  overflow: hidden;
  position: relative;
  /* Fixed 108px = natural grid height (102px) × max possible scale (1.06×).
     At max container width (704px), scale = 704/664 ≈ 1.06.
     JS overrides this to the precise scaled height on every resize.
     Using max expected height instead of 102px reduces CLS on initial render. */
  height: 108px;
}

/* Grid — transform-origin ensures scaling starts from top-left */
.gh-grid-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  transform-origin: top left;
}

.gh-grid {
  display: flex;
  flex-direction: column;
  width: max-content;
  user-select: none;
}

/* Month labels */
.gh-months {
  display: flex;
  position: relative;
  height: 16px;
  margin-bottom: 4px;
  margin-left: var(--gh-day-label-width);
  /* Hardware-accelerate transform to improve small-text rendering at tiny scales */
  will-change: transform;
  /* Subpixel antialiasing + minimum readable size at 320px viewport */
  font-size: 0.8rem;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.gh-month-label {
  position: absolute;
  font-size: 0.6875rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.65;
  white-space: nowrap;
  line-height: 1;
}

.gh-day-labels-placeholder {
  width: 0;
  height: 0;
}

/* Rows */
.gh-rows {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.gh-row {
  display: flex;
  align-items: center;
  gap: 2px;
}

.gh-day-label {
  width: var(--gh-day-label-width);
  font-size: 0.625rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.55;
  text-align: left;
  line-height: 1;
  flex-shrink: 0;
  padding-right: 4px;
}

/* Cells — fixed 10px squares */
.gh-cells {
  display: flex;
  gap: 2px;
}

.gh-cell {
  display: block;
  position: relative;
  width: 10px;
  height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.12s ease-out;
  outline: none;
}

.gh-cell:focus-visible {
  transform: scale(1.15);
  z-index: 2;
}

/* Focus ring — three-layer fallback for cross-browser compatibility */
/* 1. Base fallback (for Safari <15 and legacy mobile browsers) */
.gh-cell:focus {
  box-shadow: 0 0 0 2px oklch(var(--un-preset-theme-colors-primary));
  z-index: 10;
}

/* 2. Suppress focus ring on mouse click (pointer devices) */
.gh-cell:focus:not(:focus-visible) {
  box-shadow: none;
  z-index: auto;
}

/* 3. Precision focus ring for keyboard navigation only */
.gh-cell:focus-visible {
  box-shadow: 0 0 0 2px oklch(var(--un-preset-theme-colors-primary));
  z-index: 10;
}

/* Cell color tokens */
:root {
  --gh-cell-0: oklch(91% 0.012 85);
  --gh-cell-1: oklch(0.75 0.12 138 / 0.30);
  --gh-cell-2: oklch(0.75 0.12 138 / 0.50);
  --gh-cell-3: oklch(0.75 0.12 138 / 0.70);
  --gh-cell-4: oklch(0.75 0.12 138 / 0.95);
  --gh-day-label-width: 28px;
}

html.dark {
  --gh-cell-0: oklch(28% 0.003 298);
  --gh-cell-1: oklch(0.75 0.12 138 / 0.20);
  --gh-cell-2: oklch(0.75 0.12 138 / 0.40);
  --gh-cell-3: oklch(0.75 0.12 138 / 0.60);
  --gh-cell-4: oklch(0.75 0.12 138 / 0.85);
}

/* Cell color application */
.gh-cell--none { background-color: var(--gh-cell-0); }
.gh-cell--first-quartile { background-color: var(--gh-cell-1); }
.gh-cell--second-quartile { background-color: var(--gh-cell-2); }
.gh-cell--third-quartile { background-color: var(--gh-cell-3); }
.gh-cell--fourth-quartile { background-color: var(--gh-cell-4); }

/* Touch targets */
@media (hover: none) and (pointer: coarse) {
  .gh-cell::after {
    content: '';
    position: absolute;
    inset: -7px;
  }
}

/* Tooltip */
.gh-tooltip {
  position: absolute;
  top: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 0.6875rem;
  font-weight: 500;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.15s ease-out, visibility 0.15s ease-out;
  z-index: 100;
  line-height: 1.4;
  background-color: oklch(var(--un-preset-theme-colors-primary));
  color: oklch(var(--un-preset-theme-colors-background));
}

.gh-tooltip--visible {
  opacity: 1;
  visibility: visible;
}

@media (pointer: coarse) {
  .gh-tooltip {
    top: auto;
    bottom: calc(100% + 6px);
  }
}

/* Footer */
.gh-footer {
  margin-top: 1rem;
  display: flex;
  align-items: center;
}

.gh-total {
  font-size: 0.8125rem;
  color: oklch(var(--un-preset-theme-colors-secondary));
  opacity: 0.75;
}

/* ==============================
   Responsive Breakpoints
   ============================== */

/* Tablet Portrait: 480px–767px — header compact layout */
@media (max-width: 767px) {
  .gh-header { flex-wrap: nowrap; }
}
</style>
