<script>
// Lazy load Mermaid: only render when mermaid code blocks enter the viewport
function setupMermaidLazy() {
  // Mark raw markdown code blocks (```mermaid) by adding the mermaid class
  document.querySelectorAll('pre code.language-mermaid').forEach((code) => {
    code.closest('pre')?.classList.add('mermaid')
  })

  const mermaidBlocks = document.querySelectorAll<HTMLElement>('pre.mermaid')
  if (mermaidBlocks.length === 0)
    return

  const observer = new IntersectionObserver(
    async (entries: IntersectionObserverEntry[]) => {
      for (const entry of entries) {
        if (!entry.isIntersecting)
          continue
        const target = entry.target as HTMLElement
        observer.unobserve(target)

        try {
          const mermaid = await import('mermaid')
          mermaid.default.initialize({ startOnLoad: false })
          await mermaid.default.run({ nodes: [target] })
          // Hide the raw code text after successful render
          const codeEl = target.querySelector('code')
          if (codeEl) codeEl.style.display = 'none'
          target.dataset.mermaidLoaded = 'true'
        }
        catch (error) {
          console.error('[MermaidLazy] Failed to render:', error)
        }
      }
    },
    { rootMargin: '200px' },
  )

  mermaidBlocks.forEach((block) => {
    if (!block.dataset.mermaidLoaded) {
      observer.observe(block)
    }
  })
}

document.addEventListener('astro:page-load', setupMermaidLazy)
</script>
