---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'

interface Props {
  posts: Post[]
  lang: Language
}

const { posts, lang } = Astro.props
---

{
  posts.map((post) => {
    const slug = post.data.abbrlink || post.id
    const description = getPostDescription(post, 'list')

    return (
      <a
        href={getPostPath(slug, lang)}
        class="album-card"
        transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
        data-disable-theme-toggle-transition
      >
        <div class="album-thumbnail">
          {
            post.data.thumbnail
              ? (
                <img
                  src={post.data.thumbnail}
                  alt={post.data.title}
                  loading="lazy"
                  class="thumbnail-img"
                />
              )
              : (
                <div class="thumbnail-placeholder">
                  <span class="placeholder-text">
                    {post.data.title}
                  </span>
                </div>
              )
          }
        </div>
        <div class="album-info">
          <h3 class="album-title font-serif">{post.data.title}</h3>
          <p class="album-description">{description}</p>
          <div class="album-meta">
            <time datetime={post.data.published.toISOString()}>
              {post.data.published.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
                year: 'numeric',
                month: 'long',
              })}
            </time>
          </div>
        </div>
      </a>
    )
  })
}
