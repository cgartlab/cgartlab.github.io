---
import type { Language } from '@/i18n/config'
import { defaultLocale } from '@/config'
import { getLangFromLocale } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import * as k from '@/lib/anatomy/iso-kit.mjs'
import {
  buildChassis,
  buildChannelLinks,
  CABINET,
  chassisDefs,
  TOP,
} from '@/lib/home/chassis.mjs'
import { buildCinema, cinemaBounds } from '@/lib/home/cinema.mjs'
import { buildLabels, labelsBounds } from '@/lib/home/labels.mjs'
import { buildNewsrack, newsrackBounds } from '@/lib/home/newsrack.mjs'
import { buildToolbox, toolboxBounds } from '@/lib/home/toolbox.mjs'
import { buildTypewriter, typewriterBounds } from '@/lib/home/typewriter.mjs'
import { getAllTags, getPostsByTag, getRegularPosts } from '@/utils/content'

interface Props {
  lang?: Language
  latestTitle?: string
}

const currentLang = Astro.props.lang ?? getLangFromLocale(Astro.currentLocale)
const t = ui[currentLang as keyof typeof ui] ?? ui.zh

const posts = await getRegularPosts(currentLang)
const latest = posts[0]

const labels = currentLang === 'zh'
  ? [t.posts, t.works, t.column, t.links, t.tags]
  : ['Posts', 'Works', 'Column', 'Links', 'Tags']

const ids = ['posts', 'works', 'column', 'resource', 'tags']
const hrefs = ['/posts/', '/works/', '/column/', '/resource/', '/tags/']
  .map(path => getLocalizedPath(path, currentLang))

const W = 760
const H = 620

const bounds = [
  ...k.boxCorners(CABINET, -18, TOP),
  ...typewriterBounds(),
  ...cinemaBounds(),
  ...newsrackBounds(),
  ...toolboxBounds(),
  ...labelsBounds(),
]
const P = k.fitProjection(bounds, W, H, {
  pad: 30,
  azimuth: 90,
  elevation: 18,
  focal: 1200,
  center: [0, 0, 55],
})

// the pivot the camera turns around: the centre of mass of the cabinet
const [pivotX, pivotY] = k.iso([0, 0, TOP / 2], P)

const coverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/posts/_images/**/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
)

function coverOf(post: { body?: string }): string {
  const m = (post.body || '').match(/!\[[^\]]*\]\((.*?\.(?:webp|jpg|jpeg|png|gif))\)/)
  if (!m)
    return ''
  const raw = decodeURIComponent(m[1])
  if (raw.startsWith('http'))
    return raw
  if (raw.startsWith('./_images/') || raw.startsWith('../_images/')) {
    const name = raw.replace(/^(\.\.?\/)?_images\//, '')
    const entry = coverGlob[`/src/content/posts/_images/${name}`]
    return entry ? entry.default.src : ''
  }
  return ''
}

const columnTag = currentLang === 'zh' || currentLang === 'zh-tw' ? '专栏' : 'Journal'
const columns = (await getPostsByTag(columnTag, currentLang)).slice(0, 4)
const issues = columns.map((post) => {
  const abbr = post.data.abbrlink || ''
  const m = abbr.match(/weekly-(\d+)/)
  const n = m ? m[1] : ''
  return {
    number: n ? `No.${n}` : '',
    label: post.data.title,
    href: getPostPath(abbr || post.id, currentLang),
    cover: coverOf(post),
  }
})

// the tags page already has these; the machine prints them back out
const tags = (await getAllTags(currentLang))
  .filter(tag => tag !== '专栏' && tag !== 'Journal')
  .slice(0, 8)

const perLine = currentLang === 'zh' ? 18 : 26
const maxLines = 6

/** A plain-text excerpt of the latest post, wrapped to the sheet. */
function excerptLines(body: string, width: number, rows: number): string[] {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/[>*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
  const chars = [...text]
  const lines: string[] = []
  let cursor = 0
  while (cursor < chars.length && lines.length < rows) {
    let take = Math.min(width, chars.length - cursor)
    if (chars[cursor + take] && /\S/.test(chars[cursor + take - 1] ?? ' ') && /\S/.test(chars[cursor + take])) {
      let back = take
      while (back > width * 0.5 && chars[cursor + back - 1] !== ' ') back--
      if (chars[cursor + back - 1] === ' ') take = back - 1
    }
    if (take <= 0) take = Math.min(width, chars.length - cursor)
    lines.push(chars.slice(cursor, cursor + take).join('').trim())
    cursor += take
    while (chars[cursor] === ' ') cursor++
  }
  if (cursor < chars.length && lines.length) {
    const last = lines[lines.length - 1]
    lines[lines.length - 1] = `${[...last].slice(0, width - 1).join('')}…`
  }
  return lines.filter(Boolean)
}

const typedLines = excerptLines(latest?.body ?? '', perLine, maxLines)

const paperHref = latest
  ? getPostPath(latest.data.abbrlink || latest.id, currentLang)
  : getLocalizedPath('/posts/', currentLang)

const toolboxLabels = currentLang === 'zh'
  ? ['工具', '学习', '作者']
  : ['TOOLS', 'LEARN', 'PEOPLE']

const modules = ids.map((id, index) => {
  const caption = labels[index]
  const body = index === 0
    ? buildTypewriter(P, {
        lines: typedLines,
        paperHref,
        paperLabel: currentLang === 'zh' ? `阅读最新一篇：${latest?.data.title ?? ''}` : `Read the latest: ${latest?.data.title ?? ''}`,
      })
    : index === 1
      ? buildCinema(P, { caption })
      : index === 2
        ? buildNewsrack(P, { issues })
        : index === 3
          ? buildToolbox(P, { labels: toolboxLabels })
          : buildLabels(P, { tags, caption })
  return `<g class="home-module${index === 0 ? ' is-active' : ''}" data-index="${index}" data-module="${id}">${body}</g>`
}).join('')

const svg = `<svg class="iso-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" role="group" aria-label="CGArtLab：一台控制台，面板上有五个栏目按键，当前展示的装置立在升降台上。">
${chassisDefs(P)}
${buildChassis(P, { labels, labelSize: currentLang === 'zh' ? 9 : 8 })}
${modules}
${buildChannelLinks(P, { labels, hrefs, active: 0 })}
</svg>`

const isDefault = currentLang === defaultLocale
---

<div
  class="home-stage"
  data-home-stage
  data-typed={JSON.stringify(typedLines)}
  data-lang={currentLang}
  data-viewbox={`${W} ${H}`}
  data-pivot={`${pivotX.toFixed(2)} ${pivotY.toFixed(2)}`}
  data-is-default={isDefault ? '' : undefined}
>
  <Fragment set:html={svg} />
</div>

<script>
  import '@/components/Home/stage.client'
</script>
