---
import type { Language } from '@/i18n/config'
import { defaultLocale } from '@/config'
import { getLangFromLocale } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import * as k from '@/lib/anatomy/iso-kit.mjs'
import {
  buildChassis,
  buildChannelLinks,
  CABINET,
  chassisDefs,
  TOP,
} from '@/lib/home/chassis.mjs'
import { buildPlaceholder, placeholderBounds } from '@/lib/home/placeholder.mjs'
import { buildGallery, galleryBounds } from '@/lib/home/gallery.mjs'
import { buildNewsrack, newsrackBounds } from '@/lib/home/newsrack.mjs'
import { buildServer, serverBounds } from '@/lib/home/server.mjs'
import { buildSorter, sorterBounds } from '@/lib/home/sorter.mjs'
import { buildTelescope, telescopeBounds } from '@/lib/home/telescope.mjs'
import { buildPrinter, printerBounds } from '@/lib/home/printer.mjs'
import { buildTypewriter, typewriterBounds } from '@/lib/home/typewriter.mjs'
import { getPostsByTag, getRegularPosts } from '@/utils/content'

interface Props {
  lang?: Language
  latestTitle?: string
}

const currentLang = Astro.props.lang ?? getLangFromLocale(Astro.currentLocale)
const t = ui[currentLang as keyof typeof ui] ?? ui.zh

const posts = await getRegularPosts(currentLang)
const latest = Astro.props.latestTitle ?? posts[0]?.data.title ?? t.subtitle

const labels = currentLang === 'zh'
  ? [t.posts, t.works, t.column, t.links, t.tags, t.about, t.search]
  : ['Posts', 'Works', 'Column', 'Links', 'Tags', 'About', 'Search']

const letters = currentLang === 'zh'
  ? ['文', '作', '专', '资', '标', '关', '搜']
  : ['P', 'W', 'C', 'R', 'T', 'A', 'S']

const ids = ['posts', 'works', 'column', 'resource', 'tags', 'about', 'search']
const hrefs = ['/posts/', '/works/', '/column/', '/resource/', '/tags/', '/about/', '/search/']
  .map(path => getLocalizedPath(path, currentLang))

const W = 760
const H = 620

const bounds = [
  ...k.boxCorners(CABINET, -18, TOP),
  ...typewriterBounds(),
  ...placeholderBounds(),
  ...newsrackBounds(),
  ...printerBounds(),
  ...galleryBounds(),
  ...serverBounds(),
  ...sorterBounds(),
  ...telescopeBounds(),
]
const P = k.fitProjection(bounds, W, H, {
  pad: 30,
  azimuth: 90,
  elevation: 18,
  focal: 1200,
  center: [0, 0, 55],
})

const coverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/posts/_images/**/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
)

function coverOf(post: { body?: string }): string {
  const m = (post.body || '').match(/!\[[^\]]*\]\((.*?\.(?:webp|jpg|jpeg|png|gif))\)/)
  if (!m)
    return ''
  const raw = decodeURIComponent(m[1])
  if (raw.startsWith('http'))
    return raw
  if (raw.startsWith('./_images/') || raw.startsWith('../_images/')) {
    const name = raw.replace(/^(\.\.?\/)?_images\//, '')
    const entry = coverGlob[`/src/content/posts/_images/${name}`]
    return entry ? entry.default.src : ''
  }
  return ''
}

const columnTag = currentLang === 'zh' || currentLang === 'zh-tw' ? '专栏' : 'Journal'
const columns = (await getPostsByTag(columnTag, currentLang)).slice(0, 6)
const issues = columns.map((post) => {
  const abbr = post.data.abbrlink || ''
  const m = abbr.match(/weekly-(\d+)/)
  const n = m ? m[1] : ''
  return {
    number: n ? `No.${n}` : '',
    label: post.data.title,
    href: getPostPath(abbr || post.id, currentLang),
    cover: coverOf(post),
  }
})

const paperHref = posts[0]
  ? getPostPath(posts[0].data.abbrlink || posts[0].id, currentLang)
  : getLocalizedPath('/posts/', currentLang)

const modules = ids.map((id, index) => {
  const caption = labels[index]
  const body = index === 0
    ? buildTypewriter(P, {
        title: latest,
        paperHref,
        paperLabel: currentLang === 'zh' ? `阅读最新一篇：${latest}` : `Read the latest: ${latest}`,
      })
    : index === 1
      ? buildGallery(P, { caption })
      : index === 2
        ? buildNewsrack(P, { issues })
        : index === 3
          ? buildServer(P, { caption })
          : index === 4
            ? buildSorter(P, { caption })
            : index === 5
              ? buildPrinter(P, { caption })
              : buildTelescope(P, { caption })
  return `<g class="home-module${index === 0 ? ' is-active' : ''}" data-index="${index}" data-module="${id}">${body}</g>`
}).join('')

const svg = `<svg class="iso-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" role="group" aria-label="CGArtLab：一台控制台，面板上有七个栏目按键，当前展示的装置立在升降台上。">
${chassisDefs(P)}
${buildChassis(P, { labels, labelSize: currentLang === 'zh' ? 9 : 7 })}
${modules}
${buildChannelLinks(P, { labels, hrefs, active: 0 })}
</svg>`

const typedLines = (() => {
  const chars = [...latest]
  const perLine = 15
  const lines: string[] = []
  for (let i = 0; i < chars.length && lines.length < 3; i += perLine) {
    lines.push(chars.slice(i, i + perLine).join(''))
  }
  if (chars.length > perLine * 3) {
    const last = lines[2]
    lines[2] = `${[...last].slice(0, perLine - 1).join('')}…`
  }
  return lines
})()

const isDefault = currentLang === defaultLocale
---

<div
  class="home-stage"
  data-home-stage
  data-typed={JSON.stringify(typedLines)}
  data-lang={currentLang}
  data-is-default={isDefault ? '' : undefined}
>
  <Fragment set:html={svg} />
</div>

<script>
  import '@/components/Home/stage.client'
</script>
