---
import type { Language } from '@/i18n/config'
import { defaultLocale } from '@/config'
import { getLangFromLocale } from '@/i18n/lang'
import {
  buildChassis,
  buildChannelLinks,
  chassisDefs,
} from '@/lib/home/chassis.mjs'
import { H, lateModulePath, stageData, TAGLINES, W } from '@/lib/home/stage.mjs'

interface Props {
  lang?: Language
  latestTitle?: string
}

const currentLang = Astro.props.lang ?? getLangFromLocale(Astro.currentLocale)
const data = await stageData(currentLang)
const taglines = TAGLINES[currentLang === 'en' ? 'en' : 'zh']

const svg = `<svg class="iso-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" role="group" aria-label="CGArtLab：一台控制台，面板上有五个栏目按键，当前展示的装置立在升降台上。">
${chassisDefs(data.P)}
${buildChassis(data.P, { labels: data.labels, labelSize: currentLang === 'zh' ? 9 : 8 })}
<g class="home-modules" clip-path="url(#home-deck-clip)">${data.modules[0]}</g>
<g role="navigation" aria-label="${currentLang === 'zh' ? '站内导航' : 'Site sections'}">${buildChannelLinks(data.P, { labels: data.labels, hrefs: data.hrefs, active: 0 })}</g>
</svg>`

// The four machines that are not inlined: they are fetched after the page has
// painted, so the first screen is the console and one machine rather than five.
const late = [1, 2, 3, 4].map(i => lateModulePath(currentLang, i)).join(',')

const isDefault = currentLang === defaultLocale
---

<script is:inline>
  // The entrance belongs to stage.client.ts: the console builds itself, then the
  // first machine rides up onto the lift. The markup ships that machine already
  // `.is-active` so a reader whose module never arrives still gets a drawing —
  // but that class also starts the rise on its own, at first paint, and the
  // module then removed it mid-air and seated the machine again. That is what
  // played the entrance twice on a cold visit (measured: rise at 149 ms, cut at
  // ~640 ms, rise again at 1901 ms).
  //
  // `home-arming` is permanent: it says "this browser runs scripts", so the CSS
  // entrance never starts on its own and the module alone can play it. `home-hold`
  // is the visibility guard and it is lifted either by the module or, if the
  // module never arrives, by the timer — a reader without the module then gets the
  // drawing, settled, instead of an empty stage.
  ;(() => {
    const root = document.documentElement
    root.classList.add('home-arming', 'home-hold')
    setTimeout(() => {
      root.classList.remove('home-hold')
    }, 3500)
  })()
</script>

<div class="home-machine">
  <div
    class="home-stage"
    style={`--well-x:${data.wellX.toFixed(1)}px;--well-y:${data.wellY.toFixed(1)}px`}
    data-home-stage
    data-typed={JSON.stringify(data.typedLines)}
    data-late={late}
    data-lang={currentLang}
    data-is-default={isDefault ? '' : undefined}
  >
    <Fragment set:html={svg} />
  </div>

  <p class="home-tagline">
    {Object.entries(taglines).map(([id, text]) => (
      <span data-for={id}>{text}</span>
    ))}
  </p>
</div>

<script>
  import '@/components/Home/stage.client'
</script>
