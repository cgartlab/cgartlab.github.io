---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/language-switcher.svg'
import SearchIcon from '@/assets/icons/search-icon.svg'
import ThemeToggleIcon from '@/assets/icons/theme-toggle.svg'
import { moreLocales, themeConfig } from '@/config'
import { getNextGlobalLangPath, getNextSupportedLangPath } from '@/i18n/path'

interface Props {
  supportedLangs: Language[]
}

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

const { supportedLangs } = Astro.props
const currentPath = Astro.url.pathname

const showLanguageSwitcher = moreLocales.length > 0
const nextUrl = supportedLangs.length > 0
  ? getNextSupportedLangPath(currentPath, supportedLangs)
  : getNextGlobalLangPath(currentPath)
---

<div
  class:list={[
    'absolute right-7.25vw top-14.6 flex gap-6 min-[823px]:max-lg:right-[calc(50vw-22rem)]',
    'lg:(fixed bottom-13.5rem left-[min(calc(100vw-19rem),calc(50vw+21rem))] right-auto top-auto w-14rem)',
  ]}
>
  <button
    id="search-trigger-mobile"
    class="aspect-square w-4 c-secondary lg:hidden active:scale-90 hover:c-primary"
    aria-label="Search"
  >
    <SearchIcon
      aria-hidden="true"
      fill="currentColor"
    />
  </button>

  {showLanguageSwitcher && (
    <a
      id="language-switcher"
      href={nextUrl}
      class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
      aria-label="Switch website language"
    >
      <LanguageSwitcherIcon
        aria-hidden="true"
        fill="currentColor"
      />
    </a>
  )}

  <button
    id="theme-toggle-button"
    class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
    data-light-mode={lightMode}
    data-dark-mode={darkMode}
    aria-label="Switch light/dark theme"
  >
    <ThemeToggleIcon
      aria-hidden="true"
      fill="currentColor"
    />
  </button>
</div>

<!-- Theme Toggle Script >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
<script>
// Update DOM and meta tag for given dark state
// Does NOT touch localStorage — callers decide whether to persist
function applyThemeToDom(isDark: boolean) {
  document.documentElement.classList.toggle('dark', isDark)

  const metaThemeColor = document.head.querySelector('meta[name="theme-color"]')
  const themeButton = document.getElementById('theme-toggle-button')
  const lightMode = themeButton?.dataset.lightMode
  const darkMode = themeButton?.dataset.darkMode

  if (metaThemeColor && lightMode && darkMode) {
    metaThemeColor.setAttribute('content', isDark ? darkMode : lightMode)
  }

  document.dispatchEvent(new Event('theme-changed'))
}

// Apply theme triggered by the USER clicking the toggle button
// Persists choice to localStorage and marks as manually set
function applyThemeManual(isDark: boolean) {
  applyThemeToDom(isDark)
  localStorage.setItem('theme', isDark ? 'dark' : 'light')
  localStorage.setItem('theme-manual', 'true')
}

// Apply theme triggered by SYSTEM preference change
// Updates DOM only — never sets theme-manual flag, never writes to localStorage
function applyThemeSystem(isDark: boolean) {
  applyThemeToDom(isDark)
  // Keep localStorage in sync so page reloads are consistent,
  // but do NOT set theme-manual so auto-follow remains active
  localStorage.setItem('theme', isDark ? 'dark' : 'light')
}

// Toggle theme on user click
function toggleTheme() {
  const isDark = !document.documentElement.classList.contains('dark')
  applyThemeManual(isDark)
}

// Handle theme toggle click events
function handleThemeToggle(e: MouseEvent) {
  if (!(e.target instanceof Element)) {
    return
  }

  if (!e.target.closest('#theme-toggle-button')) {
    return
  }

  // If reduceMotion is enabled or View Transitions API unavailable, update theme directly
  if (document.documentElement.classList.contains('reduce-motion')
    || !document.startViewTransition) {
    toggleTheme()
    return
  }

  document.documentElement.setAttribute('data-theme-changing', '')

  // Use View Transitions API for theme toggle
  // Force synchronous reflow to ensure CSS variables are recalculated before snapshot capture
  const transition = document.startViewTransition(() => {
    void document.documentElement.offsetHeight
    toggleTheme()
  })

  // Remove temporary marker after view transition
  transition.finished.then(() => {
    document.documentElement.removeAttribute('data-theme-changing')
  })
}

// Listen to system theme changes in real time
// Only follow system if the user has NOT manually overridden the theme
function handleSystemChange(event: MediaQueryListEvent) {
  const isManual = localStorage.getItem('theme-manual') === 'true'
  if (isManual) {
    return // User has explicitly chosen a theme — respect it
  }

  applyThemeSystem(event.matches)
}

function setupThemeListeners() {
  document.addEventListener('click', handleThemeToggle)
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', handleSystemChange)
}

function cleanupThemeListeners() {
  document.removeEventListener('click', handleThemeToggle)
  window.matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', handleSystemChange)
}

document.addEventListener('astro:page-load', setupThemeListeners)
document.addEventListener('astro:before-swap', cleanupThemeListeners)
</script>
