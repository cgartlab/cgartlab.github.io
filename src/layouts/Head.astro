---
import type { Language } from '@/i18n/config'
import { ClientRouter } from 'astro:transitions'
import katexCSS from 'katex/dist/katex.min.css?url'
import { allLocales, base, defaultLocale, themeConfig } from '@/config'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  postDate?: Date
  postUpdated?: Date
  postKatex?: boolean
  ogImage?: string
  postSchemaType?: 'SoftwareApplication' | 'Product'
  supportedLangs?: Language[]
}

// Props and Language
const { postTitle, postDescription, postSlug, postDate, postUpdated, postKatex, ogImage, postSchemaType, supportedLangs = [] } = Astro.props
const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

// Site Configuration
const { title, subtitle, description, i18nTitle, author } = themeConfig.site
const { mode: defaultMode, light: { background: lightMode }, dark: { background: darkMode } } = themeConfig.color
const { katex: katexGlobal, reduceMotion } = themeConfig.global
const { verification = {}, twitterID = '', googleAnalyticsID = '', umamiAnalyticsID = '' } = themeConfig.seo ?? {}
const { google = '', bing = '', yandex = '', baidu = '' } = verification
const { customGoogleAnalyticsJS = '', customUmamiAnalyticsJS = '' } = themeConfig.preload ?? {}


// Site Metadata
const metaTheme = defaultMode === 'dark' ? darkMode : lightMode
const siteSubtitle = i18nTitle ? currentUI.subtitle : subtitle
const siteDescription = i18nTitle ? currentUI.description : description

// Site SEO Metadata (longer, more descriptive, used only in <title> and OG tags)
const seoSiteTitle = i18nTitle ? (currentUI.seoTitle || currentUI.title) : title

// Page Metadata
const pageTitle = postTitle ? `${postTitle} | ${seoSiteTitle}` : `${seoSiteTitle} - ${siteSubtitle}`
const pageDescription = postDescription || siteDescription
const pageImage = ogImage
  ? new URL(`${base}${ogImage}`, Astro.url.origin)
  : postSlug
    ? new URL(`${base}/og/${postSlug}.png`, Astro.url.origin)
    : new URL(`${base}/images/og-default.png`, Astro.url.origin)

// Tool/product structured data details, keyed by abbrlink slug from the URL path
const pathSlug = Astro.url.pathname.match(/\/posts\/([^/]+)\//)?.[1]
const softwareAppMeta: Record<string, { operatingSystem: string, applicationCategory: string }> = {
  'layerrenamer-1': { operatingSystem: 'macOS, Windows', applicationCategory: 'UtilitiesApplication' },
  'layerrenamer': { operatingSystem: 'macOS, Windows', applicationCategory: 'UtilitiesApplication' },
  'goto-github': { operatingSystem: 'macOS, Linux, Windows', applicationCategory: 'DeveloperApplication' },
}
const softwareApp = postSchemaType === 'SoftwareApplication' ? softwareAppMeta[pathSlug || ''] : undefined
---

<head>
<!-- 不输出 <base> 标签：站点为根路径部署（base='/'），输出 <base href="/">
     会把页内片段链接（TOC 目录锚点 #slug、术语表字母跳转 #letter-X）的解析
     基准改为站点根，点击后跳转回首页而非当前页。搜索脚本用
     document.querySelector('base')?.getAttribute('href') || '/' 读取 base，
     无 <base> 时回退 '/' 与根部署一致。 -->
<!-- Preconnect to third-party domains -->
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
{postSlug && <link rel="preconnect" href="https://giscus.app" crossorigin />}
<!-- Prevent FOUC: Apply theme class before any rendering -->
<script is:inline define:vars={{ defaultMode }}>
(function () {
  // Priority: forced mode > auto+manual > auto+system
  let _dark
  if (defaultMode === 'dark') {
    _dark = true
  }
  else if (defaultMode === 'light') {
    _dark = false
  }
  else {
    // auto mode
    const _mode = localStorage.getItem('theme-mode') || 'system'
    if (_mode === 'dark')
      _dark = true
    else if (_mode === 'light')
      _dark = false
    else _dark = window.matchMedia('(prefers-color-scheme: dark)').matches
  }
  if (_dark)
    document.documentElement.classList.add('dark')
})()
</script>
<!-- Basic Info -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<!-- Favicons with cache busting -->
<link rel="icon" type="image/x-icon" href={`${base}/favicon.ico?v=2`} />
<link rel="icon" type="image/svg+xml" href={`${base}/icons/favicon.svg?v=2`} />
<link rel="icon" type="image/png" href={`${base}/icons/favicon.png?v=2`} />
<link rel="apple-touch-icon" href={`${base}/icons/favicon.png?v=2`} />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={author} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={metaTheme} />

<!-- Preload -->
<link rel="preload" href={`${base}/fonts/EarlySummer-VF-Split/EarlySummer-VF-Subset.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}/fonts/Snell-Black-SF.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}/fonts/Snell-Bold-SF.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}/fonts/STIX-VF.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}/fonts/STIX-Italic-VF.woff2`} as="font" type="font/woff2" crossorigin />
{(katexGlobal && postKatex !== false) && <link rel="stylesheet" href={katexCSS} media="print" onload={`this.media='all'`} />}

<!-- Site Links -->
<link rel="canonical" href={Astro.url} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
{(() => {
  // en 页面指向 en feed，其他语言指向默认（zh）feed
  const feedPrefix = currentLang === 'en' ? '/en' : ''
  return (
    <>
      <link rel="alternate" href={`${base}${feedPrefix}/rss.xml`} type="application/rss+xml" title="RSS Feed" />
      <link rel="alternate" href={`${base}${feedPrefix}/atom.xml`} type="application/atom+xml" title="Atom Feed" />
    </>
  )
})()}
{(() => {
  const currentPath = Astro.url.pathname
  const pathWithoutLang = currentPath.replace(/^\/(en|zh-tw)\//, '/')
  // 页面声明了 supportedLangs（且与全站语言列表不同）时，仅输出这些语言的 alternate，
  // 避免为不存在的语言版本（如 zh-only 标签页的 /en/tags/xxx/）生成 404 链接
  const hasRestrictedLangs = supportedLangs.length > 0
    && !(supportedLangs.length === allLocales.length && allLocales.every(l => supportedLangs.includes(l as Language)))
  const langs = hasRestrictedLangs ? supportedLangs : allLocales
  const alternateUrls = langs.map(l => ({
    lang: l === 'zh-tw' ? 'zh-TW' : l,
    href: new URL(
      l === defaultLocale ? pathWithoutLang : `/${l}${pathWithoutLang}`,
      Astro.url.origin,
    ).href,
  }))
  return alternateUrls.map(({ lang, href }) => (
    <link rel="alternate" hreflang={lang} href={href} />
  ))
})()}
{(() => {
  const currentPath = Astro.url.pathname
  const pathWithoutLang = currentPath.replace(/^\/(en|zh-tw)\//, '/')
  // 与 alternate 块共用同一守卫：受限语言页面（如 en-only 标签页）时，
  // x-default 不能指向不存在的 zh 版本（404），应指向真实存在的语言版本。
  const hasRestrictedLangs = supportedLangs.length > 0
    && !(supportedLangs.length === allLocales.length && allLocales.every(l => supportedLangs.includes(l as Language)))
  if (!hasRestrictedLangs) {
    return (
      <link
        rel="alternate"
        href={new URL(pathWithoutLang, Astro.url.origin).href}
        hreflang="x-default"
      />
    )
  }
  // 受限语言：x-default 指向 supportedLangs 中按 allLocales 优先级最靠前的真实版本
  const priority = new Map(allLocales.map((l, i) => [l, i]))
  const preferred = [...supportedLangs].sort(
    (a, b) => (priority.get(a) ?? Number.MAX_SAFE_INTEGER) - (priority.get(b) ?? Number.MAX_SAFE_INTEGER),
  )[0]
  if (!preferred)
    return null
  const href = preferred === defaultLocale ? pathWithoutLang : `/${preferred}${pathWithoutLang}`
  return (
    <link
      rel="alternate"
      href={new URL(href, Astro.url.origin).href}
      hreflang="x-default"
    />
  )
})()}

<!-- Open Graph -->
<meta property="og:type" content={postTitle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={pageImage} />
<meta name="twitter:card" content="summary_large_image" />
{twitterID && <meta name="twitter:site" content={twitterID} />}

<!-- Site Verification -->
{google && <meta name="google-site-verification" content={google} />}
{bing && <meta name="msvalidate.01" content={bing} />}
{yandex && <meta name="yandex-verification" content={yandex} />}
{baidu && <meta name="baidu-site-verification" content={baidu} />}

<!-- JSON-LD Structured Data -->
{postSlug
? (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'headline': postTitle,
    'description': pageDescription,
    'image': pageImage.toString(),
    'url': Astro.url.toString(),
    'author': {
      '@type': 'Person',
      'name': author,
    },
    'publisher': {
      '@type': 'Organization',
      'name': seoSiteTitle,
      'logo': {
        '@type': 'ImageObject',
        'url': new URL(`${base}/icons/favicon.svg`, Astro.url.origin).toString(),
      },
    },
    'datePublished': (postDate || new Date()).toISOString(),
    'dateModified': (postUpdated ?? postDate)?.toISOString(),
    'mainEntityOfPage': {
      '@type': 'WebPage',
      '@id': Astro.url.toString(),
    },
  })}
  />
)
: (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': seoSiteTitle,
    'description': siteDescription,
    'url': Astro.url.toString(),
    'author': {
      '@type': 'Person',
      'name': author,
    },
    'publisher': {
      '@type': 'Organization',
      'name': seoSiteTitle,
      'sameAs': [
        'https://github.com/cgartlab',
        'https://x.com/cgartlab',
        'https://t.me/cg_artlab',
      ],
    },
    'inLanguage': currentLang,
    // No `potentialAction` / SearchAction: the search box is an overlay on every
    // page now, so there is no URL that accepts `?q=`. The old template pointed at
    // /search?q=…, which the Worker 301s back to the homepage — structured data
    // that promises a search endpoint has to have one. (Google retired the
    // sitelinks search box in 2024, so nothing is lost by dropping it.)
  })}
  />
)}

{/* Tool/Product structured data — emitted alongside BlogPosting for relevant posts */}
{softwareApp && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    'name': postTitle,
    'operatingSystem': softwareApp.operatingSystem,
    'applicationCategory': softwareApp.applicationCategory,
    'description': pageDescription,
    'image': pageImage.toString(),
    'url': Astro.url.toString(),
    'author': {
      '@type': 'Person',
      'name': author,
    },
    'publisher': {
      '@type': 'Organization',
      'name': seoSiteTitle,
      'logo': {
        '@type': 'ImageObject',
        'url': new URL(`${base}/icons/favicon.svg`, Astro.url.origin).toString(),
      },
    },
    'datePublished': (postDate || new Date()).toISOString(),
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
  })}
  />
)}
{postSchemaType === 'Product' && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    'name': 'Beelink SER5 Max',
    'description': pageDescription,
    'image': pageImage.toString(),
    'url': Astro.url.toString(),
    'brand': {
      '@type': 'Brand',
      'name': 'Beelink',
    },
    'datePublished': (postDate || new Date()).toISOString(),
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
  })}
  />
)}

<!-- BreadcrumbList Structured Data -->
{(() => {
  const { maxBreadcrumbItems } = themeConfig.global
  const origin = Astro.url.origin
  const pathname = Astro.url.pathname
  const segments = pathname.split('/').filter(Boolean)

  // Build breadcrumb items from URL path
  const items: { '@type': 'ListItem', 'position': number, 'name': string, 'item': string }[] = [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': seoSiteTitle,
      'item': `${origin}${base}/`,
    },
  ]

  let accumPath = `${origin}${base}/`
  let pos = 2
  for (const seg of segments) {
    // Skip language prefix segments (en, zh-tw)
    if (seg === 'en' || seg === 'zh-tw') {
      accumPath = `${accumPath}${seg}/`
      continue
    }
    accumPath = `${accumPath}${seg}/`
    // Only add meaningful segments (exclude UUIDs, IDs)
    if (seg.length > 1 && !/^\d+$/.test(seg) && seg !== 'posts') {
    // Skip raw post slugs and internal paths
      items.push({
        '@type': 'ListItem',
        'position': pos++,
        'name': seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
        'item': accumPath,
      })
    }
  }

  if (items.length <= 1)
    return null

  return (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': items.slice(0, maxBreadcrumbItems),
    })}
    />
  )
})()}

<!-- Global View Transition -->
<!-- fallback="animate"：不支持 View Transitions API 的浏览器仍跑渐进增强动画，
     否则 astro:page-load 永不派发，全站挂在该事件上的交互（主题切换、评论、
     图片缩放、TOC、搜索等 44 处）会整体失效。 -->
<ClientRouter fallback="animate" />

<!-- Theme Toggle -->
<script
  is:inline
  define:vars={{
    defaultMode,
    lightMode,
    darkMode,
    reduceMotion,
 }}
>
(function () {
  // Determine if dark mode should be active.
  // Priority (highest → lowest):
  //   1. Forced mode in config (light / dark) — always wins
  //   2. auto mode + user has manually toggled — respect stored choice
  //   3. auto mode + no manual override — follow system preference
  function isCurrentDark() {
    if (defaultMode === 'dark')
      return true
    if (defaultMode === 'light')
      return false

    // auto mode
    const mode = localStorage.getItem('theme-mode') || 'system'
    if (mode === 'dark')
      return true
    if (mode === 'light')
      return false

    // No manual override — always follow system preference
    return window.matchMedia('(prefers-color-scheme: dark)').matches
  }

  // Apply theme class + meta theme-color to the given document
  function initTheme(doc) {
    doc = doc || document
    const isDark = isCurrentDark()
    doc.documentElement.classList.toggle('dark', isDark)

    const metaThemeColor = doc.head.querySelector('meta[name="theme-color"]')
    if (metaThemeColor) {
      metaThemeColor.setAttribute('content', isDark ? darkMode : lightMode)
    }
  }

  // Apply reduce-motion class to the given document
  function initMotionPref(doc) {
    doc = doc || document
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const supportsViewTransitions = 'startViewTransition' in doc
    const shouldReduceMotion = reduceMotion || prefersReducedMotion || !supportsViewTransitions
    doc.documentElement.classList.toggle('reduce-motion', shouldReduceMotion)
  }

  // Apply theme to the INCOMING document BEFORE the swap so there is
  // zero flash between the outgoing and incoming pages.
  document.addEventListener('astro:before-swap', (e) => {
    initTheme(e.newDocument)
    initMotionPref(e.newDocument)
  })

  // Initialize theme on first load
  initTheme()
  initMotionPref()
})()
</script>

<!-- Analytics（GA / Umami）—— 只有用户选择「全部接受」后才创建脚本。
     2026-11-17：此前这两个脚本无条件注入，Cookie 横幅的「拒绝 / 仅功能」形同虚设；
     现在 Gating 在主线程读取 localStorage('consent-preference')，同意了才把
     type="text/partytown" 的脚本插进 head，Partytown 照旧接管转发。 -->
{(googleAnalyticsID || umamiAnalyticsID) && (
  <script
    is:inline
    define:vars={{
      googleAnalyticsID,
      customGoogleAnalyticsJS,
      umamiAnalyticsID,
      customUmamiAnalyticsJS,
    }}
  >
(function () {
  var CONSENT_KEY = 'consent-preference'
  var started = false
  function readConsent() {
    try { return localStorage.getItem(CONSENT_KEY) } catch (e) { return null }
  }
  // GA Consent Mode：默认拒绝，先建 dataLayer，同意了再 update 成 granted
  if (googleAnalyticsID) {
    window.dataLayer = window.dataLayer || []
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments) }
    window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied' })
  }
  function start() {
    if (started) return
    started = true
    if (googleAnalyticsID) {
      window.gtag('js', new Date())
      window.gtag('consent', 'update', { analytics_storage: 'granted' })
      if (customGoogleAnalyticsJS)
        window.gtag('config', googleAnalyticsID, { transport_url: new URL(customGoogleAnalyticsJS).origin })
      else
        window.gtag('config', googleAnalyticsID)
      var ga = document.createElement('script')
      ga.src = customGoogleAnalyticsJS || ('https://www.googletagmanager.com/gtag/js?id=' + googleAnalyticsID)
      ga.type = 'text/partytown'
      document.head.appendChild(ga)
    }
    if (umamiAnalyticsID) {
      var um = document.createElement('script')
      um.src = customUmamiAnalyticsJS || 'https://cloud.umami.is/script.js'
      um.setAttribute('data-website-id', umamiAnalyticsID)
      um.type = 'text/partytown'
      document.head.appendChild(um)
    }
  }
  function stop() {
    // 已注入的脚本无法卸载，但 GA 收到 denied 后立刻停写 cookie；
    // Umami 没有运行时开关，撤销后下次刷新不再加载。
    if (googleAnalyticsID && typeof window.gtag === 'function')
      window.gtag('consent', 'update', { analytics_storage: 'denied' })
  }
  if (readConsent() === 'accepted') start()
  window.addEventListener('consent:change', function (e) {
    if (e.detail === 'accepted') start()
    else stop()
  })
})()
  </script>
)}
</head>
